---
// Plantilla simple para las páginas legales: header, título, fecha y texto en una columna legible.
import Layout from "@/layouts/Layout.astro";
import Header from "@/sections/Header.astro";
import Footer from "@/sections/Footer.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  updated: string;
}

const { title, description, heading, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <Header />
  <main id="contenido" tabindex="-1">
    <section class="tone-light pb-24 pt-36 lg:pb-32 lg:pt-44">
      <div class="shell">
        <h1 class="t-display max-w-[20ch]">{heading}</h1>
        <span class="rule mt-10" aria-hidden="true"></span>
        <p class="t-label-sm mt-6 text-tone-muted">Última actualización: {updated}</p>
        <div class="legal-prose mt-12 max-w-[44rem]">
          <slot />
          <p class="legal-note">Este texto es un modelo general y no reemplaza el asesoramiento legal.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Reglas de texto con la misma escala que t-sub1 y t-body-lg */
  .legal-prose :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.375rem, 2.25vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .legal-prose :global(h2[id]) {
    scroll-margin-top: 8rem;
  }
  .legal-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-prose :global(p),
  .legal-prose :global(ul),
  .legal-prose :global(table) {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
  }
  .legal-prose :global(p + p),
  .legal-prose :global(p + ul),
  .legal-prose :global(ul + p),
  .legal-prose :global(p + table),
  .legal-prose :global(.table-wrap + p) {
    margin-top: 1rem;
  }
  .legal-prose :global(ul) {
    list-style: disc;
    padding-left: 1.25em;
  }
  .legal-prose :global(li + li) {
    margin-top: 0.375rem;
  }
  .legal-prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  .legal-prose :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .legal-prose :global(.table-wrap) {
    overflow-x: auto;
    margin-top: 1rem;
  }
  .legal-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }
  .legal-prose :global(th),
  .legal-prose :global(td) {
    padding: 0.75rem 1rem 0.75rem 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  .legal-prose :global(th) {
    font-family: var(--font-display);
    font-weight: 500;
  }
  .legal-prose .legal-note {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
