---
const title = "Servicio de Inyección de Plásticos en Moreno - Matrifer Moldes";
const description = "Somos una empresa con 30 años de experiencia especializada en la inyección de plásticos en Moreno, ofreciendo soluciones de alta calidad para tus necesidades de fabricación. Contáctanos para obtener más información sobre nuestros servicios";
import Header from '@/sections/Header.astro';
import Layout from '@/layouts/Layout.astro';
import Hero from '@/sections/Hero.astro';
import About from '@/sections/About.astro';
import Servicios from '@/sections/Servicios.astro';
import WhyUs from '@/sections/WhyUs.astro';
import News from '@/sections/News.astro';
import Contact from '@/sections/Contact.astro';
import Footer from '@/sections/Footer.astro';
---

<Layout title={title} description={description}>
	<Header />
	<Hero />
	<About />
	<Servicios />
	<WhyUs />
	<News />
	<Contact />
	<Footer />
</Layout>
