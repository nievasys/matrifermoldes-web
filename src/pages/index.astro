---
const title = "Servicio de Inyección de Plásticos en Moreno - Matrifer Moldes";
const description = "Somos una empresa con 30 años de experiencia especializada en la inyección de plásticos en Moreno, ofreciendo soluciones de alta calidad para tus necesidades de fabricación. Contáctanos para obtener más información sobre nuestros servicios";
import Header from '@/sections/Header.astro';
import Layout from '@/layouts/Layout.astro';
import Hero from '@/sections/Hero.astro';
import About from '@/sections/About.astro';
import Servicios from '@/sections/Servicios.astro';
import CaseStudies from '@/sections/CaseStudies.astro';
import WhyUs from '@/sections/WhyUs.astro';
import News from '@/sections/News.astro';
import Contact from '@/sections/Contact.astro';
import Location from '@/sections/Location.astro';
import Footer from '@/sections/Footer.astro';
---

<Layout title={title} description={description}>
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			name: "Matrifer Moldes",
			description,
			url: "/",
			image: "/logo.svg",
			telephone: "+54 9 11 5420-0297",
			address: {
				"@type": "PostalAddress",
				addressLocality: "Moreno",
				addressRegion: "Buenos Aires",
				addressCountry: "AR"
			},
			serviceType: [
				"Inyección de termoplásticos",
				"Matricería",
				"Mecanizado CNC",
				"Diseño CAD/CAM",
				"Electroerosión"
			],
			sameAs: [
				"https://www.tiktok.com/@matrifermoldes",
				"https://www.instagram.com/matrifermoldes"
			]
		})}
	/>
	<Header />
	<Hero />
	<Servicios />
	<CaseStudies />
	<About />
	<WhyUs />
	<News />
	<Contact />
	<Location />
	<Footer />
</Layout>
