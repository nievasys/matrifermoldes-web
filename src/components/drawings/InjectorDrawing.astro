---
// Inyectora horizontal en elevación lateral, dibujo de línea fina.
// Calcada de una inyectora real: unidad de cierre con protector a la
// izquierda, columna de mando, unidad de inyección y tablero a la derecha.
// Coordenadas de la máquina en un grupo desplazado 20 unidades a la derecha;
// el suelo está en y = 428. La geometría repetida se genera desde arrays.

const GROUND = 428;

// Rieles dobles al fondo, a sangre: se extienden más allá del viewBox
const rails = [318, 324, 372, 378];
const RAIL_FROM = -2400;
const RAIL_TO = 3840;

// Soportes de riel fuera de la máquina, como módulos repetidos
const railBrackets = [-180, -60, 60, 180, 1300, 1420, 1540, 1660];

// Tornillo con cruz: círculo + X
const bolt = (cx: number, cy: number, r = 4) => ({ cx, cy, r, d: r * 0.62 });

// Protector de seguridad: parantes y travesaños de las ventanas
const guardMullions = [168, 210];
const guardPanes = [410, 470, 547];

// Puerta corrediza: abierta sobre el protector, cerrada tapa el molde
// hasta la platina fija (recorrido de 170 en x, ver el ciclo).
const DOOR = { x: 412, y: 127, w: 174, h: 162 };
const doorPanes = [470, 511];

// Pieza inyectada: asiento de silla de perfil, entre las mitades del molde
const SEAT = { x: 670, y: 158 };

// Columnas guía (tie bars): dos arriba y dos abajo, en líneas dobles
const tieBars = [140, 161, 252, 270];
const TIE_FROM = 586;
const TIE_TO = 766;

// Platina móvil: bujes de las columnas y tornillos
const movingBolts = [bolt(603, 186), bolt(603, 226)];

// Bancada: costuras de paneles, zócalo y orificios
const baseSeams = [565, 597, 792];
const plinthSeams = [452, 565, 597, 775, 792, 862, 964, 1051];
const baseHoles = [
  [579, 352],
  [579, 360],
  [579, 368],
  [655, 316],
  [710, 316],
];

// Ventilador: rejilla circular con listones
const FAN = { cx: 407, cy: 318, r: 8 };
const fanSlats = [-5, -2.5, 0, 2.5, 5].map((dy) => {
  const half = Math.sqrt(FAN.r ** 2 - dy ** 2) - 1;
  return { x1: FAN.cx - half, x2: FAN.cx + half, y: FAN.cy + dy };
});

// Chapa semilla de melón sobre el tablero
const checker = Array.from({ length: 32 }, (_, i) => 816 + i * 10);

// Tablero eléctrico: rejillas, triángulos de advertencia, indicadores
const louvres = [
  { x: 880, y: 305, w: 27, h: 28 },
  { x: 1105, y: 375, w: 27, h: 28 },
];
const louvreSlats = (l: { y: number; h: number }) =>
  Array.from({ length: 7 }, (_, i) => l.y + 4 + i * ((l.h - 8) / 6));
const warnings = [920, 999, 1088];
const indicators = [318, 333, 348];
const doorEdges = [964, 1051];

// Cubierta perforada del cañón
const perforations = [202, 208, 214].flatMap((cy, row) =>
  Array.from({ length: 9 }, (_, i) => ({ cx: 855 + i * 6 + (row % 2) * 3, cy })),
);

// Tolva: bandas del cono, interpoladas sobre sus lados
const CONE = { top: 126, bottom: 178, l0: 882, r0: 970, l1: 916, r1: 938 };
const coneBands = [140, 158].map((y) => {
  const t = (y - CONE.top) / (CONE.bottom - CONE.top);
  return { y, x1: CONE.l0 + (CONE.l1 - CONE.l0) * t, x2: CONE.r0 + (CONE.r1 - CONE.r0) * t };
});

// Carcasa de inyección: manómetros y orificios
const gauges = [994, 1009];
const housingHoles = [935, 977].flatMap((cx) => [210, 225].map((cy) => [cx, cy]));

// Panel de control: teclas en grilla
const softKeys = Array.from({ length: 8 }, (_, i) => 794 + i * 6.5);
const leftKeys = Array.from({ length: 15 }, (_, i) => ({
  cx: 795 + (i % 3) * 6,
  cy: 185 + Math.floor(i / 3) * 6,
}));
const rightKeys = Array.from({ length: 12 }, (_, i) => ({
  x: 821 + (i % 4) * 6.5,
  y: 184 + Math.floor(i / 4) * 6,
}));
const panelButtons = [795, 805.5, 816.5];
---

<div class="injector overflow-hidden">
  <div class="flex justify-center">
    <svg
      class="drawing min-w-[900px] max-w-none shrink-0 lg:w-[122%]"
      data-draw
      data-injector
      viewBox="0 0 1440 440"
      preserveAspectRatio="xMidYMax meet"
      aria-hidden="true"
    >
      <!-- Rieles de fondo a sangre -->
      {rails.map((y) => <line class="is-faint" x1={RAIL_FROM} y1={y} x2={RAIL_TO} y2={y} />)}
      {
        railBrackets.map((cx) => (
          <g>
            <rect class="is-solid" x={cx - 18} y="304" width="36" height="88" />
            <rect class="is-faint" x={cx - 12} y="310" width="24" height="76" />
            <rect class="is-faint" x={cx - 5} y="342" width="10" height="12" />
            {[321, 375].map((cy) => (
              <g>
                <circle cx={cx} cy={cy} r="7" />
                <line x1={cx - 4.5} y1={cy - 4.5} x2={cx + 4.5} y2={cy + 4.5} />
                <line x1={cx - 4.5} y1={cy + 4.5} x2={cx + 4.5} y2={cy - 4.5} />
              </g>
            ))}
          </g>
        ))
      }

      <!-- Suelo -->
      <line x1={RAIL_FROM} y1={GROUND} x2={RAIL_TO} y2={GROUND} />

      <g transform="translate(20 0)">
        <!-- Zócalo con riel inferior rehundido -->
        <rect class="is-solid" x="412" y="405" width="703" height="23" />
        <rect x="420" y="410" width="687" height="13" />
        {plinthSeams.map((x) => <line x1={x} y1="410" x2={x} y2="423" />)}

        <!-- Bancada -->
        <rect class="is-solid" x="370" y="288" width="492" height="12" />
        <rect class="is-solid" x="412" y="300" width="450" height="105" />
        {baseSeams.map((x) => <line x1={x} y1="300" x2={x} y2="405" />)}
        <line x1="412" y1="398" x2="862" y2="398" />
        {baseHoles.map(([cx, cy]) => <circle cx={cx} cy={cy} r="1.5" />)}

        <!-- Ventana de inspección -->
        <rect x="629" y="341" width="110" height="36" />
        <rect class="is-faint" x="633" y="345" width="102" height="28" />

        <!-- Ménsula inclinada de lubricación -->
        <polygon class="is-solid" points="372,300 412,300 412,398 404,398" />
        <circle cx="392" cy="362" r="3" />

        <!-- Ventilador, etiqueta y accesorios del extremo izquierdo -->
        <circle cx={FAN.cx} cy={FAN.cy} r={FAN.r} />
        {fanSlats.map(({ x1, x2, y }) => <line x1={x1} y1={y} x2={x2} y2={y} />)}
        <rect x="417" y="307" width="20" height="33" />
        {[314, 320, 326].map((y) => <line x1="421" y1={y} x2="433" y2={y} />)}
        <rect class="is-solid" x="522" y="290" width="38" height="40" />
        <rect x="528" y="296" width="14" height="18" />
        <circle cx="535" cy="322" r="4" />
        <rect x="565" y="292" width="15" height="20" />
        <circle cx="572.5" cy="302" r="3" />

        <!-- Bomba de lubricación, manguera y filtro -->
        <rect class="is-solid" x="347" y="320" width="33" height="32" />
        <rect x="353" y="326" width="14" height="18" />
        <rect class="is-solid" x="352" y="314" width="20" height="6" />
        <path d="M368 314 C368 298 390 296 398 312 L416 340" />
        <rect class="is-solid" x="410" y="338" width="20" height="5" />
        <rect class="is-solid" x="412" y="343" width="16" height="49" />
        <line x1="420" y1="350" x2="420" y2="384" />
        <rect class="is-solid" x="415" y="392" width="10" height="6" />

        <!-- Tablero eléctrico bajo la unidad de inyección -->
        <rect class="is-solid" x="810" y="280" width="330" height="15" />
        {checker.map((x) => <line class="is-faint" x1={x} y1="290" x2={x + 4} y2="285" />)}
        <circle cx="835" cy="276" r="4" />
        <rect class="is-solid" x="862" y="295" width="277" height="120" />
        <line x1="875" y1="295" x2="875" y2="415" />
        {indicators.map((y) => <rect x="865" y={y} width="7" height="9" />)}
        {
          doorEdges.map((x) => (
            <g>
              <line x1={x} y1="295" x2={x} y2="415" />
              <line x1={x + 2} y1="295" x2={x + 2} y2="415" />
              <rect x={x - 3} y="320" width="3" height="10" />
              <rect x={x - 3} y="385" width="3" height="10" />
            </g>
          ))
        }
        <rect x="1135" y="320" width="3" height="10" />
        <rect x="1135" y="385" width="3" height="10" />
        {
          louvres.map((l) => (
            <g>
              <rect x={l.x} y={l.y} width={l.w} height={l.h} />
              {louvreSlats(l).map((y) => (
                <line x1={l.x + 3} y1={y} x2={l.x + l.w - 3} y2={y} />
              ))}
            </g>
          ))
        }
        {
          warnings.map((cx) => (
            <g>
              <polygon points={`${cx},342 ${cx + 8},356 ${cx - 8},356`} />
              <polyline points={`${cx + 1},346 ${cx - 1.5},351 ${cx + 1.5},351 ${cx - 1},354`} />
            </g>
          ))
        }
        <!-- Interruptor principal -->
        <rect x="1105" y="310" width="20" height="26" />
        <circle cx="1115" cy="323" r="5" />
        <line x1="1115" y1="317" x2="1115" y2="329" />

        <!-- Columnas guía: de la protección a la platina fija -->
        {
          tieBars.map((y) => (
            <g>
              <line x1={TIE_FROM} y1={y - 3} x2={TIE_TO} y2={y - 3} />
              <line x1={TIE_FROM} y1={y + 3} x2={TIE_TO} y2={y + 3} />
            </g>
          ))
        }

        <!-- Platina móvil + mitad móvil del molde (cierra y abre) -->
        <g data-injector-moving>
          <rect class="is-solid" x="470" y="199" width="120" height="12" />
          <line x1="470" y1="205" x2="590" y2="205" />
          <rect class="is-solid" x="588" y="130" width="30" height="152" />
          <rect x="593" y="148" width="20" height="116" />
          {
            tieBars.map((y) => (
              <rect class="is-solid" x="585" y={y - 6} width="36" height="12" />
            ))
          }
          {
            movingBolts.map(({ cx, cy, r, d }) => (
              <g>
                <circle cx={cx} cy={cy} r={r} />
                <line x1={cx - d} y1={cy - d} x2={cx + d} y2={cy + d} />
                <line x1={cx - d} y1={cy + d} x2={cx + d} y2={cy - d} />
              </g>
            ))
          }
          <rect class="is-solid" x="618" y="168" width="16" height="88" />
          <line x1="626" y1="168" x2="626" y2="256" />
          {[184, 240].map((cy) => <circle cx="622" cy={cy} r="2" />)}
        </g>

        <!-- Protector exterior (izquierda) -->
        <rect class="is-solid" x="260" y="108" width="90" height="172" />
        <line x1="260" y1="128" x2="350" y2="128" />
        <rect x="264" y="131" width="82" height="118" />
        {guardMullions.map((y) => <line class="is-faint" x1="264" y1={y} x2="346" y2={y} />)}
        <line x1="260" y1="252" x2="350" y2="252" />
        <rect x="268" y="257" width="76" height="17" />
        {[150, 230].map((y) => <rect x="258" y={y} width="3" height="10" />)}

        <!-- Protector fijo con ventanas (la puerta corre por delante) -->
        <rect class="is-solid" x="348" y="102" width="238" height="187" />
        <line x1="348" y1="127" x2="586" y2="127" />
        <rect x="536" y="108" width="20" height="16" />
        <polygon points="541,120 546,111 551,120" />
        <rect x="352" y="130" width="230" height="124" />
        {guardPanes.map((x) => <line x1={x} y1="130" x2={x} y2="254" />)}
        {guardMullions.map((y) => <line class="is-faint" x1="352" y1={y} x2="582" y2={y} />)}
        <line x1="348" y1="258" x2="586" y2="258" />
        <rect x="356" y="262" width="190" height="22" />
        <!-- Guía superior de la puerta, hasta la platina fija -->
        <line x1="586" y1="124" x2="756" y2="124" />

        <!-- Baliza sobre poste -->
        <rect class="is-solid" x="308" y="58" width="4" height="50" />
        <rect class="is-solid" x="304" y="104" width="12" height="4" />
        <rect class="is-solid" x="305" y="22" width="10" height="4" />
        <rect class="is-solid" x="303" y="26" width="14" height="32" rx="2" />
        <line x1="303" y1="36" x2="317" y2="36" />
        <line x1="303" y1="47" x2="317" y2="47" />

        <!-- Mitad fija del molde y platina fija -->
        <rect class="is-solid" x="738" y="156" width="20" height="102" />
        <line x1="746" y1="156" x2="746" y2="258" />
        {[180, 232].map((cy) => <circle cx="752" cy={cy} r="2.5" />)}
        <circle cx="735" cy="212" r="3.5" />
        <rect class="is-solid" x="756" y="120" width="12" height="172" />
        {tieBars.map((y) => <rect class="is-solid" x="754" y={y - 5} width="12" height="10" />)}

        <!-- Asiento inyectado: aparece con el molde abierto y se expulsa -->
        <g data-draw-skip>
          <g data-injector-seat opacity="0">
            <g transform={`translate(${SEAT.x} ${SEAT.y})`}>
              <path
                style="stroke: var(--color-matrifer-cyan); fill: color-mix(in srgb, var(--color-matrifer-cyan) 12%, transparent);"
                d="M2 15 C3 6 10 2 20 1 C27 0 31 4 31 11 L30 82 L30 93 C30 97 26 98 24 95 L22 87 L5 87 C2 87 1 84 1 80 C0 59 0 36 2 15 Z"
              />
              <path
                style="stroke: var(--color-matrifer-cyan); opacity: 0.6;"
                d="M23 4 C27 7 27 13 26 22 L25 86"
              />
            </g>
          </g>
        </g>

        <!-- Puerta corrediza con ventanas y manija (cierra para inyectar) -->
        <g data-injector-door>
          <rect class="is-solid" x={DOOR.x} y={DOOR.y} width={DOOR.w} height={DOOR.h} />
          <rect x={DOOR.x + 4} y="131" width="140" height="123" />
          {doorPanes.map((x) => <line x1={x} y1="131" x2={x} y2="254" />)}
          {
            guardMullions.map((y) => (
              <line class="is-faint" x1={DOOR.x + 4} y1={y} x2={DOOR.x + 144} y2={y} />
            ))
          }
          <line x1={DOOR.x} y1="258" x2={DOOR.x + DOOR.w} y2="258" />
          <rect x={DOOR.x + 8} y="262" width="134" height="22" />
          <line x1={DOOR.x + 148} y1="131" x2={DOOR.x + 148} y2="254" />
          <rect class="is-solid" x="568" y="134" width="7" height="138" rx="3.5" />
          <line x1={DOOR.x + 150} y1="144" x2="568" y2="144" />
          <line x1={DOOR.x + 150} y1="262" x2="568" y2="262" />
        </g>

        <!-- Columna de mando (platina fija carenada) -->
        <rect class="is-solid" x="765" y="114" width="45" height="180" />
        <line x1="765" y1="126" x2="810" y2="126" />
        <line x1="772" y1="126" x2="772" y2="294" />
        <line x1="765" y1="252" x2="810" y2="252" />

        <!-- Panel de control -->
        <rect class="is-solid" x="784" y="126" width="69" height="119" />
        <rect x="788" y="130" width="61" height="111" />
        <rect x="792" y="134" width="52" height="40" />
        <rect class="is-faint" x="795" y="137" width="46" height="34" />
        {softKeys.map((x) => <rect x={x} y="177" width="4" height="2.5" />)}
        {leftKeys.map(({ cx, cy }) => <circle cx={cx} cy={cy} r="1.3" />)}
        {rightKeys.map(({ x, y }) => <rect x={x} y={y} width="4" height="3" />)}
        <line x1="790" y1="216" x2="847" y2="216" />
        {panelButtons.map((cx) => <circle cx={cx} cy="226" r="3" />)}
        <rect x="825" y="222" width="5" height="8" />
        <!-- Parada de emergencia -->
        <circle cx="839" cy="225" r="6" />
        <line x1="839" y1="231" x2="839" y2="238" />

        <!-- Riel del carro de inyección -->
        <rect class="is-solid" x="878" y="272" width="222" height="8" />

        <!-- Unidad de inyección: carro, boquilla y cañón (avanza al inyectar) -->
        <g data-injector-carriage>
        <rect class="is-solid" x="844" y="200" width="6" height="58" />
        <rect class="is-solid" x="868" y="234" width="26" height="38" />
        <circle cx="875" cy="248" r="4" />
        <circle cx="886" cy="261" r="4" />
        <rect class="is-solid" x="850" y="197" width="62" height="23" />
        {perforations.map(({ cx, cy }) => <circle cx={cx} cy={cy} r="1" />)}
        <rect class="is-solid" x="850" y="221" width="60" height="13" />

        <!-- Carcasa de inyección -->
        <polygon class="is-solid" points="912,182 1104,182 1112,192 1112,272 912,272" />
        <line x1="912" y1="264" x2="1112" y2="264" />
        {housingHoles.map(([cx, cy]) => <circle cx={cx} cy={cy} r="1.5" />)}
        {
          gauges.map((cx) => (
            <g>
              <circle cx={cx} cy="193" r="6" />
              <circle cx={cx} cy="193" r="4.5" />
              <line x1={cx} y1="193" x2={cx + 3} y2="190" />
            </g>
          ))
        }
        <rect x="1020" y="187" width="15" height="10" />
        <polygon points="1023,195 1026,189 1029,195" />
        <rect x="917" y="234" width="18" height="12" />
        <polygon points="920,244 923,237 926,244" />
        <rect x="1002" y="230" width="43" height="6" />
        <rect x="1090" y="228" width="18" height="22" />
        {[233, 238, 243].map((y) => <line class="is-faint" x1="1092" y1={y} x2="1106" y2={y} />)}

        <!-- Tolva cónica sobre la garganta de alimentación -->
        <rect class="is-solid" x="919" y="176" width="16" height="12" />
        <rect class="is-solid" x="905" y="186" width="72" height="7" />
        <rect class="is-solid" x="953" y="193" width="8" height="18" rx="3" />
        <polygon
          class="is-solid"
          points={`${CONE.l0},${CONE.top} ${CONE.r0},${CONE.top} ${CONE.r1},${CONE.bottom} ${CONE.l1},${CONE.bottom}`}
        />
        {coneBands.map(({ y, x1, x2 }) => <line x1={x1} y1={y} x2={x2} y2={y} />)}
        <rect class="is-faint" x="922" y="130" width="10" height="40" />
        <rect class="is-solid" x="882" y="104" width="88" height="22" />
        <line x1="882" y1="114" x2="970" y2="114" />
        <rect class="is-solid" x="879" y="96" width="94" height="8" />
        </g>
      </g>

      <!-- Piezas animadas por opacidad: fuera del fundido general -->
      <g data-draw-skip transform="translate(20 0)">
        <rect class="is-accent" data-injector-lamp x="306" y="28" width="8" height="6" />
        <circle class="is-accent" cx="839" cy="225" r="2.5" />
      </g>
    </svg>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<SVGSVGElement>("svg[data-injector]").forEach((svg) => {
    if (reduce) return;
    const moving = svg.querySelector("[data-injector-moving]");
    const lamp = svg.querySelector("[data-injector-lamp]");
    const door = svg.querySelector("[data-injector-door]");
    const carriage = svg.querySelector("[data-injector-carriage]");
    const seat = svg.querySelector("[data-injector-seat]");
    if (!moving || !lamp || !door || !carriage || !seat) return;

    // Ciclo de moldeo (7.6 s): cierra la puerta, cierra el molde, inyecta
    // (avanza el carro y se enciende la baliza), abre el molde, abre la
    // puerta y el asiento queda a la vista y se expulsa hacia abajo.
    // El asiento solo se hace visible detrás de la puerta cerrada y con el
    // molde ya abierto; la puerta lo descubre al correrse.
    gsap.set(lamp, { opacity: 0.25 });
    const cycle = gsap.timeline({ paused: true, repeat: -1, defaults: { ease: "power2.inOut" } });
    cycle
      .set(seat, { opacity: 0, y: 0 }, 0)
      .to(door, { x: 170, duration: 1 }, 0)
      .to(moving, { x: 104, duration: 1.2 }, 1)
      .to(carriage, { x: -5, duration: 0.5 }, 2.2)
      .to(lamp, { opacity: 1, duration: 0.3, ease: "sine.inOut" }, 2.2)
      .to(carriage, { x: 0, duration: 0.5 }, 3.2)
      .to(lamp, { opacity: 0.25, duration: 0.4, ease: "sine.inOut" }, 3.4)
      .to(moving, { x: 0, duration: 1.2 }, 3.7)
      .set(seat, { opacity: 1 }, 4.9)
      .to(door, { x: 0, duration: 1 }, 4.9)
      .to(seat, { y: 56, duration: 0.9, ease: "power2.in" }, 6.1)
      .to(seat, { opacity: 0, duration: 0.5, ease: "sine.in" }, 6.5)
      .to({}, { duration: 0.6 }, 7);

    // Arranca después del dibujado inicial y se pausa fuera de pantalla
    let visible = false;
    let ready = false;
    const sync = () => (ready && visible ? cycle.play() : cycle.pause());
    ScrollTrigger.create({
      trigger: svg,
      start: "top bottom",
      end: "bottom top",
      onToggle: (self) => {
        visible = self.isActive;
        sync();
      },
    });
    gsap.delayedCall(2, () => {
      ready = true;
      sync();
    });
  });
</script>
