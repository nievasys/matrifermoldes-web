---
// Mitad de un molde de cruz (accesorio de cuatro vías), dibujada en línea fina.
// Vista superior girada 45° con una leve oblicua, como la foto de referencia.
// Ejes de la placa: X a la derecha, Y hacia abajo, Z altura. El observador mira desde +X +Y
// y desde arriba, así que la esquina (+P, +P) queda abajo y es la más cercana.
// Se dibuja de atrás hacia adelante; las caras .is-solid tapan lo que queda detrás.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

type V = [number, number, number];
type P2 = [number, number];
type Shape = { tag: "polygon" | "polyline"; points: string; cls?: string };
type Pin = { shapes: Shape[] };

const OX = 378;
const OY = 300;
const SC = 0.86; // escala general
const K = 0.8; // achatamiento vertical de la planta
const HZ = 0.6; // escala de las alturas
const S2 = Math.SQRT2;

const pr = ([x, y, z]: V): P2 => [OX + ((x - y) / S2) * SC, OY + (((x + y) / S2) * K - z * HZ) * SC];
const fmt = (pts: P2[]) => pts.map(([a, b]) => `${a.toFixed(1)},${b.toFixed(1)}`).join(" ");
const poly = (vs: V[], cls?: string): Shape => ({ tag: "polygon", points: fmt(vs.map(pr)), cls });
const path = (vs: V[], cls?: string): Shape => ({ tag: "polyline", points: fmt(vs.map(pr)), cls });
const range = (n: number, a: number, b: number) =>
  Array.from({ length: n + 1 }, (_, i) => a + ((b - a) * i) / n);

// Dirección hacia el observador: sirve para saber qué caras y qué medias vueltas se ven.
const VIEW: V = [1, 1, (S2 * K) / HZ];

// Medidas del modelo (unidades del viewBox antes de proyectar).
const P = 200; // media placa
const T = 26; // espesor de la placa
const R = 48; // radio de curvatura de los codos
const RC = 34; // radio del canal (media caña)
const L = 56; // distancia del eje de cada tramo recto al centro
const CB = L + R; // centro de curvatura de los codos, sobre la diagonal
const BH = 34; // altura de los bloques de esquina
const PIN_R = 12;
const PIN_LEN = 150;

const quadrants: P2[] = [
  [-1, -1],
  [1, -1],
  [-1, 1],
  [1, 1],
];

// Envolvente convexa (cadena monótona) para el contorno de los cilindros.
const hull = (pts: P2[]): P2[] => {
  const s = [...pts].sort((p, q) => p[0] - q[0] || p[1] - q[1]);
  const cross = (o: P2, a: P2, b: P2) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
  const build = (list: P2[]) => {
    const out: P2[] = [];
    for (const p of list) {
      while (out.length >= 2 && cross(out[out.length - 2], out[out.length - 1], p) <= 0) out.pop();
      out.push(p);
    }
    return out;
  };
  const lower = build(s);
  const upper = build(s.reverse());
  return [...lower.slice(0, -1), ...upper.slice(0, -1)];
};

// Prisma vertical sobre una planta convexa: tapa y solo las caras laterales que miran al observador.
const prism = (foot: P2[], z0: number, z1: number, cls = "is-solid"): Shape[] => {
  const cx = foot.reduce((s, p) => s + p[0], 0) / foot.length;
  const cy = foot.reduce((s, p) => s + p[1], 0) / foot.length;
  const n = foot.length;
  const visible = foot.map((a, i) => {
    const b = foot[(i + 1) % n];
    let nx = b[1] - a[1];
    let ny = a[0] - b[0];
    if (nx * ((a[0] + b[0]) / 2 - cx) + ny * ((a[1] + b[1]) / 2 - cy) < 0) [nx, ny] = [-nx, -ny];
    return nx + ny > 1e-6;
  });
  const start = visible.findIndex((v, i) => !v && visible[(i + 1) % n]);
  const sides: Shape[] = [];
  let run: P2[] = [];
  const flush = () => {
    if (run.length < 2) return;
    sides.push(poly([...run.map(([x, y]) => [x, y, z1] as V), ...[...run].reverse().map(([x, y]) => [x, y, z0] as V)], cls));
  };
  for (let k = 1; k <= n; k++) {
    const i = (start + k) % n;
    if (visible[i]) {
      if (!run.length) run.push(foot[i]);
      run.push(foot[(i + 1) % n]);
    } else {
      flush();
      run = [];
    }
  }
  flush();
  return [...sides, poly(foot.map(([x, y]) => [x, y, z1] as V), cls)];
};

// Circunferencia horizontal (en planta) a la altura z.
const disc = (x: number, y: number, z: number, r: number, cls?: string): Shape =>
  poly(range(36, 0, Math.PI * 2).slice(0, -1).map((t) => [x + r * Math.cos(t), y + r * Math.sin(t), z] as V), cls);

// ---------- Base y placa ----------
const base: Shape[] = prism(
  [
    [-P - 12, -P - 12],
    [P + 12, -P - 12],
    [P + 12, P + 12],
    [-P - 12, P + 12],
  ],
  -T - 58,
  -T,
);

const body: Shape[] = [];

// Caras frontales de la placa con la boca de media caña de cada tramo que sale.
const mouth = (along: number, sign: -1 | 1) =>
  range(12, 0, Math.PI).map((t) => [along + sign * RC * Math.cos(t), -RC * Math.sin(t)] as P2);
const faceProfile = (): P2[] => [
  [-P, 0],
  ...mouth(-L, -1),
  ...mouth(L, -1),
  [P, 0],
  [P, -T],
  [-P, -T],
];
body.push(poly(faceProfile().map(([a, z]) => [P, a, z] as V), "is-solid"));
body.push(poly(faceProfile().map(([a, z]) => [a, P, z] as V), "is-solid"));
body.push(
  poly(
    [
      [-P, -P, 0],
      [P, -P, 0],
      [P, P, 0],
      [-P, P, 0],
    ],
    "is-solid",
  ),
);

// ---------- Codos: media caña con tramos rectos, curva y ranuras anulares ----------
// Punto de la superficie del canal: o es el desplazamiento transversal desde el eje.
const elbowLine = ([sx, sy]: P2, o: number, z: number): V[] => {
  const cx = sx * CB;
  const cy = sy * CB;
  const rho = R + o;
  const legA: V[] = [
    [cx - sx * rho, sy * P, z],
    [cx - sx * rho, cy, z],
  ];
  const bend: V[] = range(18, 0, Math.PI / 2).map((t) => [cx - sx * rho * Math.cos(t), cy - sy * rho * Math.sin(t), z]);
  const legB: V[] = [
    [cx, cy - sy * rho, z],
    [sx * P, cy - sy * rho, z],
  ];
  return [...legA, ...bend.slice(1, -1), ...legB];
};

// Ranura anular: media vuelta transversal sobre un tramo recto, a una distancia del codo.
const groove = ([sx, sy]: P2, leg: "a" | "b", d: number): V[] =>
  range(14, 0, Math.PI).map((t) => {
    const o = RC * Math.cos(t);
    const z = -RC * Math.sin(t);
    return leg === "a"
      ? [sx * CB - sx * (R + o), sy * (CB + d), z]
      : [sx * (CB + d), sy * CB - sy * (R + o), z];
  });

for (const q of quadrants) {
  body.push(path(elbowLine(q, -RC, 0)), path(elbowLine(q, RC, 0)));
  for (const t of [Math.PI / 3, Math.PI / 2, (2 * Math.PI) / 3]) {
    body.push(path(elbowLine(q, RC * Math.cos(t), -RC * Math.sin(t)), "is-faint"));
  }
  for (const leg of ["a", "b"] as const) {
    for (const d of [38, 46]) body.push(path(groove(q, leg, d)));
  }
}

// ---------- Bebedero en cruz en el centro ----------
const A = 50; // largo de cada brazo
const RW = 6; // medio ancho
const toPlate = (p: number, q: number, z: number): V => [(p + q) / S2, (p - q) / S2, z];
const runnerOutline = (z: number): V[] => {
  const pts: P2[] = [];
  const arms: P2[] = [
    [1, 0],
    [0, -1],
    [-1, 0],
    [0, 1],
  ];
  for (const [ax, ay] of arms) {
    const nx = -ay;
    const ny = ax;
    pts.push([(ax + nx) * RW, (ay + ny) * RW]);
    const base0 = Math.atan2(ny, nx);
    for (const t of range(8, base0, base0 - Math.PI)) {
      pts.push([ax * A + RW * Math.cos(t), ay * A + RW * Math.sin(t)]);
    }
  }
  return pts.map(([p, q]) => toPlate(p, q, z));
};
body.push(poly(runnerOutline(0)), poly(runnerOutline(-5), "is-faint"));
const sprue = disc(0, 0, 0, 4.5, "is-accent").points;

// ---------- Bloques de esquina con buje guía ----------
const blockFoot = ([sx, sy]: P2): P2[] => {
  const inner = L + RC;
  const arc = range(8, 0, Math.PI / 2).map(
    (t) => [sx * CB - sx * (R - RC) * Math.cos(t), sy * CB - sy * (R - RC) * Math.sin(t)] as P2,
  );
  return [[sx * P, sy * P], [sx * inner, sy * P], ...arc, [sx * P, sy * inner]];
};
const blocks = [...quadrants].sort((a, b) => a[0] + a[1] - (b[0] + b[1]));
for (const q of blocks) {
  const [sx, sy] = q;
  body.push(...prism(blockFoot(q), 0, BH));
  const bc = (P + L + RC) / 2;
  body.push(disc(sx * bc, sy * bc, BH, 24, "is-solid"), disc(sx * bc, sy * bc, BH, 16));
  body.push(disc(sx * bc + 1.5, sy * bc + 1.5, BH - 9, 15.5, "is-faint"));
  body.push(disc(sx * (L + RC + 14), sy * (L + RC + 14), BH, 3));
}

// ---------- Noyos laterales: ocho pernos largos con punta achaflanada ----------
const ringPts = (c: V, d: P2, r: number, n = 28): V[] =>
  range(n, 0, Math.PI * 2)
    .slice(0, -1)
    .map((t) => [c[0] - d[1] * r * Math.cos(t), c[1] + d[0] * r * Math.cos(t), c[2] + r * Math.sin(t)]);
const along = (c: V, d: P2, s: number): V => [c[0] + d[0] * s, c[1] + d[1] * s, c[2]];
const halfRing = (c: V, d: P2, r: number): V[] => {
  const e1: V = [-d[1], d[0], 0];
  const phi = Math.atan2(VIEW[2], e1[0] * VIEW[0] + e1[1] * VIEW[1]);
  return range(16, phi - Math.PI / 2, phi + Math.PI / 2).map((t) => [
    c[0] + e1[0] * r * Math.cos(t),
    c[1] + e1[1] * r * Math.cos(t),
    c[2] + r * Math.sin(t),
  ]);
};
const cyl = (a: V, b: V, d: P2, ra: number, rb: number): Shape => ({
  tag: "polygon",
  points: fmt(hull([...ringPts(a, d, ra), ...ringPts(b, d, rb)].map(pr))),
  cls: "is-solid",
});

const pins = quadrants.flatMap(([sx, sy]) => [
  { start: [sx * L, sy * P, -4] as V, d: [0, sy] as P2 },
  { start: [sx * P, sy * L, -4] as V, d: [sx, 0] as P2 },
]);
const makePin = ({ start, d }: { start: V; d: P2 }): Pin => {
  const facing = d[0] + d[1] > 0;
  const body0 = cyl(start, along(start, d, PIN_LEN - 8), d, PIN_R, PIN_R);
  const tip = cyl(along(start, d, PIN_LEN - 8), along(start, d, PIN_LEN), d, PIN_R, PIN_R * 0.68);
  const shapes = facing ? [body0, tip] : [tip, body0];
  shapes.push(path(halfRing(along(start, d, PIN_LEN - 24), d, PIN_R)));
  shapes.push(path(halfRing(along(start, d, PIN_LEN - 30), d, PIN_R), "is-faint"));
  if (facing) shapes.push(poly(ringPts(along(start, d, PIN_LEN), d, PIN_R * 0.68, 20)));
  return { shapes };
};
const depth = ({ start, d }: { start: V; d: P2 }) => start[0] + start[1] + (d[0] + d[1]) * PIN_LEN;
const backPins = pins.filter((p) => p.d[0] + p.d[1] < 0).sort((a, b) => depth(a) - depth(b)).map(makePin);
const frontPins = pins.filter((p) => p.d[0] + p.d[1] > 0).sort((a, b) => depth(a) - depth(b)).map(makePin);
---

<svg
  class:list={["drawing", className]}
  data-draw
  data-mold
  viewBox="0 0 720 620"
  aria-hidden="true"
  focusable="false"
>
  {base.map((s) => (s.tag === "polygon" ? <polygon points={s.points} class={s.cls} /> : <polyline points={s.points} class={s.cls} />))}
  {backPins.map((pin) => (
    <g>
      {pin.shapes.map((s) => (s.tag === "polygon" ? <polygon points={s.points} class={s.cls} /> : <polyline points={s.points} class={s.cls} />))}
    </g>
  ))}
  {body.map((s) => (s.tag === "polygon" ? <polygon points={s.points} class={s.cls} /> : <polyline points={s.points} class={s.cls} />))}
  <polygon points={sprue} class="is-accent" />
  {frontPins.map((pin) => (
    <g>
      {pin.shapes.map((s) => (s.tag === "polygon" ? <polygon points={s.points} class={s.cls} /> : <polyline points={s.points} class={s.cls} />))}
    </g>
  ))}
</svg>
