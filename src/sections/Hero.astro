---
// Hero: título, regla, etiqueta + bajada con CTA, y el dibujo de la inyectora a sangre.
import InjectorDrawing from "@/components/drawings/InjectorDrawing.astro";

const whatsappNumber = "5491154200297";
const defaultMessage =
  "Hola! Vi la página web de Matrifer Moldes y quería consultar por los servicios de inyección de plásticos.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<section
  class="tone-dark relative z-10 flex min-h-[100dvh] flex-col overflow-hidden"
  aria-labelledby="hero-titulo"
>
  <div class="shell pt-28 lg:pt-[7.5rem]">
    <h1 id="hero-titulo" class="t-display reveal max-w-[34ch]">
      Servicio de inyección de termoplásticos y matricería en Moreno.
    </h1>

    <span class="rule mt-10 lg:mt-9" data-rule></span>

    <div class="mt-8 grid grid-cols-12 gap-x-5 gap-y-6 lg:mt-9">
      <p class="t-label reveal col-span-12 max-w-[13rem] lg:col-span-4" style="--d:1">
        Inyección a terceros
      </p>
      <div class="reveal col-span-12 lg:col-span-5 lg:col-start-6" style="--d:2">
        <p class="t-sub2">
          Ofrecemos soluciones integrales donde la precisión está asegurada y el rendimiento, diseñado.
        </p>
        <a
          class="btn btn-primary mt-8"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Solicitar presupuesto<span class="sr-only"> (se abre en una pestaña nueva)</span> <i class="ph ph-whatsapp-logo text-[1.25rem]" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>

  <!-- Dibujo a sangre: se sale apenas por el borde inferior -->
  <div class="mt-auto -mb-6 pt-10 lg:-mb-4 lg:pt-6">
    <InjectorDrawing />
  </div>
</section>
