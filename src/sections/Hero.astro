---
// Imagen de fondo del hero. Reemplazar por la imagen definitiva cuando esté disponible.
const heroImage = "/hero_image.webp";
import SectionBadge from "@/components/SectionBadge.astro";

const whatsappNumber = "5491154200297";
const defaultMessage =
  "Hola! Vi la página web de Matrifer Moldes y quería consultar por los servicios de inyección de plásticos.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<section
  class="relative flex min-h-[100dvh] flex-col justify-end overflow-hidden bg-void-base pb-14 pt-24"
  aria-label="Presentación de Matrifer Moldes"
>
  <!-- Fondo cinematográfico -->
  <div class="absolute inset-0 z-0 bg-black" aria-hidden="true">
    <img
      src={heroImage}
      alt=""
      role="presentation"
      class="h-full w-full object-cover object-center"
      fetchpriority="high"
      decoding="async"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-void-base via-transparent to-black/50"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-void-base/85 via-transparent to-void-base/60"
    >
    </div>
  </div>

  <!-- Contenido principal -->
  <div class="relative z-10 mx-auto w-full max-w-[1720px] px-6 lg:px-12">
    <div class="max-w-4xl">
      <!-- Badge de categoría -->
      <div class="mb-6">
        <SectionBadge label="MATRIFER MOLDES" />
      </div>

      <!-- Titular -->
      <h1
        class="mb-10 max-w-3xl font-display text-4xl font-semibold leading-[1.08] tracking-tight text-white sm:text-5xl lg:max-w-4xl lg:text-[54px]"
      >
        Servicio de inyección de termoplásticos y matricería en Moreno.
      </h1>

      <!-- CTA de WhatsApp -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mb-10 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-matrifer-blue-deep to-matrifer-indigo px-7 py-3.5 font-sans text-xs font-semibold uppercase tracking-wider text-white shadow-lg shadow-blue-500/20 transition-all duration-200 hover:opacity-95"
      >
        Solicitar presupuesto
        <i class="ph ph-arrow-right text-sm" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>
