---
// Imagen de planta a sangre y bloque de pilares con el dibujo del molde que se abre.
import SectionLabel from "@/components/SectionLabel.astro";
import MoldDrawing from "@/components/drawings/MoldDrawing.astro";

const whatsappNumber = "5491154200297";
const defaultMessage =
  "Hola! Vi la página web de Matrifer Moldes y quería consultar por los servicios de inyección de plásticos.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(defaultMessage)}`;

const pilares = [
  {
    texto: "Ingeniería liderada desde el primer día",
  },
  {
    texto: "Pensamiento a nivel sistema, no solo de componentes",
  },
  {
    texto: "Iteración rápida sin comprometer la garantía",
  },
  {
    texto: "Probados bajo presión de alto rendimiento",
  },
];
---

<section class="tone-dark overflow-clip" aria-labelledby="whyus-titulo">
  <!-- Imagen a sangre que se abre desde un marco al hacer scroll -->
  <div data-cover class="relative h-[70dvh] overflow-hidden lg:h-[100dvh]">
    <img
      src="/whyus_image.webp"
      alt="Vista desde arriba de la planta de Matrifer Moldes con inyectoras y pallets de material"
      width="1280"
      height="1600"
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="shell pb-24 pt-20 lg:pb-40 lg:pt-32">
    <h2 id="whyus-titulo" class="t-statement max-w-[52rem]">
      Cada pieza es el resultado de precisión, pasión y décadas de ingeniería dedicada a
      perfeccionar cada ciclo productivo.
    </h2>

    <div class="mt-16 grid grid-cols-12 gap-x-5 gap-y-12 lg:mt-28">
      <div class="col-span-12 lg:col-span-6">
        <SectionLabel label="¿Por qué trabajar con nosotros?" as="h3" />
        <div class="-ml-[22%] mt-10 w-[122%] lg:-mb-24 lg:-ml-[16%] lg:mt-6 lg:w-[120%]">
          <MoldDrawing />
        </div>
      </div>

      <div class="col-span-12 lg:col-span-5 lg:col-start-8">
        <ul class="flex flex-col gap-8">
          {pilares.map((pilar) => (
            <li class="border-t border-tone-line pt-5">
              <h4 class="t-sub3 text-white">{pilar.texto}</h4>
            </li>
          ))}
        </ul>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-light mt-12"
        >
          Solicitar presupuesto<span class="sr-only"> (se abre en una pestaña nueva)</span>
          <i class="ph ph-arrow-elbow-down-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</section>
