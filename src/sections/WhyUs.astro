---
const pilares = [
  {
    numero: "01",
    texto: "Ingeniería liderada desde el primer día",
  },
  {
    numero: "02",
    texto: "Pensamiento a nivel sistema, no solo de componentes",
  },
  {
    numero: "03",
    texto: "Iteración rápida sin comprometer la garantía",
  },
  {
    numero: "04",
    texto: "Probados bajo presión de alto rendimiento",
  },
];
---

<section class="border-t border-stroke-subtle bg-void-base pt-20" aria-label="Por qué trabajar con nosotros">
  <div class="mx-auto w-full max-w-[1720px] px-6 lg:px-12">
    <!-- Título -->
    <h2
      class="mb-14 font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl"
    >
      ¿Por qué trabajar con nosotros?
    </h2>

    <!-- Pilares numerados -->
    <div class="mb-20 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      {pilares.map((pilar) => (
        <div class="border-l border-stroke-medium py-2 pl-6">
          <span
            class="mb-4 block font-display text-xs font-bold tracking-wider text-matrifer-cyan"
          >
            {pilar.numero}
          </span>
          <p class="font-sans text-base font-normal leading-snug text-white">
            {pilar.texto}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Banner con cita -->
  <div class="relative w-full overflow-hidden border-y border-stroke-subtle">
    <img
      src="/whyus_image.webp"
      alt="Planta industrial de Matrifer Moldes"
      class="h-[280px] w-full object-cover sm:h-[320px] lg:h-[360px]"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-void-base/80"></div>
    <div class="absolute inset-0 flex items-center justify-center px-6 py-10 sm:px-12 sm:py-14">
      <div class="max-w-4xl text-center">
        <span
          class="mb-6 inline-block font-sans text-xs font-semibold uppercase tracking-[0.2em] text-matrifer-cyan"
        >
          Matrifer Moldes
        </span>
        <h3
          class="font-display text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl lg:text-[44px]"
        >
          "Cada pieza es el resultado de precisión, pasión y décadas de ingeniería
          dedicada a perfeccionar cada ciclo productivo."
        </h3>
      </div>
    </div>
  </div>
</section>
