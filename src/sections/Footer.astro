---
const navColumnaCompany = [
  { label: "Nosotros", href: "#about" },
  { label: "Servicios", href: "#servicios" },
  { label: "Noticias", href: "#noticias" },
  { label: "Contacto", href: "#contacto" },
  { label: "Ubicación", href: "#" },
];

const navColumnaServicios = [
  { label: "Inyección", href: "#servicios" },
  { label: "Matricería", href: "#servicios" },
  { label: "CNC", href: "#servicios" },
  { label: "Diseño CAD/CAM", href: "#servicios" },
  { label: "Electroerosión", href: "#servicios" },
];

const navColumnaLegal = [
  { label: "Política de privacidad", href: "#" },
  { label: "Términos y condiciones", href: "#" },
  { label: "Política de cookies", href: "#" },
  { label: "Gestionar cookies", href: "#" },
];

const PLATFORMS = {
  tiktok: "https://www.tiktok.com/@matrifermoldes",
  instagram: "https://www.instagram.com/matrifermoldes?stkn=MWRxODJnbHp2YTl1Mw",
  facebook:
    "https://www.facebook.com/people/Matrifer-Moldes/pfbid022aodJ7Si9uXxu3qjeDxzKv8QLQ8K8MJDT2aPuTVPjz9hQ4TuB4Ms49AJ7rDVuchxl/",
};
---

<footer
  class="border-t border-stroke-divider bg-void-footer pb-12 pt-16 font-sans text-content-secondary"
  aria-label="Pie de página"
>
  <div class="mx-auto w-full max-w-[1720px] px-6 lg:px-12">
    <!-- Navegación superior -->
    <div
      class="grid grid-cols-1 gap-10 border-b border-stroke-divider pb-16 md:grid-cols-2 lg:grid-cols-5"
    >
      <!-- Marca y distintivos -->
      <div class="space-y-8 lg:col-span-2">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-3">
            <img
              src="/logo.svg"
              alt="Logo Matrifer Moldes"
              class="h-9 w-auto object-contain"
              loading="lazy"
            />
            <div
              class="flex flex-col pl-2.5 text-[11px] font-medium leading-[13px] tracking-tight"
            >
              <span
                class="font-display text-lg font-extrabold uppercase tracking-wider text-white"
              >
                MATRIFER MOLDES
              </span>
              <span
                class="text-[10px] uppercase tracking-widest text-content-secondary"
              >
                Inyección a terceros
              </span>
            </div>
          </a>
        </div>
      </div>

      <!-- Columna: Empresa -->
      <div>
        <h4
          class="mb-5 font-display text-xs font-semibold uppercase tracking-widest text-white"
        >
          Empresa
        </h4>
        <ul class="space-y-3 text-xs">
          {
            navColumnaCompany.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna: Servicios -->
      <div>
        <h4
          class="mb-5 font-display text-xs font-semibold uppercase tracking-widest text-white"
        >
          Servicios
        </h4>
        <ul class="space-y-3 text-xs">
          {
            navColumnaServicios.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna: Legal -->
      <div>
        <h4
          class="mb-5 font-display text-xs font-semibold uppercase tracking-widest text-white"
        >
          Legal
        </h4>
        <ul class="space-y-3 text-xs">
          {
            navColumnaLegal.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Pie inferior: redes y copyright -->
    <div
      class="flex flex-col items-start justify-between gap-6 pt-8 text-[11px] leading-relaxed text-content-muted lg:flex-row lg:items-center"
    >
      <div
        class="flex font-display items-center gap-6 text-xs uppercase tracking-widest text-content-secondary"
      >
        <a
          href={PLATFORMS.tiktok}
          class="flex items-center gap-1 transition-colors hover:text-white"
        >
          TIKTOK ↗
        </a>
        <a
          href={PLATFORMS.instagram}
          class="flex items-center gap-1 transition-colors hover:text-white"
        >
          INSTAGRAM ↗
        </a>
        <a
          href={PLATFORMS.facebook}
          class="flex items-center gap-1 transition-colors hover:text-white"
        >
          FACEBOOK ↗
        </a>
      </div>
      <div class="max-w-2xl w-full text-right font-light lg:ml-auto">
        © 2026 Matrifer Moldes. Especialistas en matricería de alta
        precisión y servicios de inyección técnica de termoplásticos a terceros.
      </div>
    </div>
  </div>
</footer>
