---
import BlueprintGrid from "@/components/drawings/BlueprintGrid.astro";

const navColumnaCompany = [
  { label: "Nosotros", href: "#about" },
  { label: "Servicios", href: "#servicios" },
  { label: "Contacto", href: "#contacto" },
  { label: "Ubicación", href: "#ubicacion" },
];

const navColumnaServicios = [
  { label: "Inyección", href: "#servicios" },
  { label: "Matricería", href: "#servicios" },
  { label: "CNC", href: "#servicios" },
  { label: "Diseño CAD/CAM", href: "#servicios" },
  { label: "Electroerosión", href: "#servicios" },
];

const navColumnaLegal = [
  { label: "Política de privacidad", href: "#" },
  { label: "Términos y condiciones", href: "#" },
  { label: "Política de cookies", href: "#" },
  { label: "Gestionar cookies", href: "#" },
];

const PLATFORMS = {
  tiktok: "https://www.tiktok.com/@matrifermoldes",
  instagram: "https://www.instagram.com/matrifermoldes?stkn=MWRxODJnbHp2YTl1Mw",
  facebook:
    "https://www.facebook.com/people/Matrifer-Moldes/pfbid022aodJ7Si9uXxu3qjeDxzKv8QLQ8K8MJDT2aPuTVPjz9hQ4TuB4Ms49AJ7rDVuchxl/",
};

const redes = [
  { label: "TikTok", href: PLATFORMS.tiktok },
  { label: "Instagram", href: PLATFORMS.instagram },
  { label: "Facebook", href: PLATFORMS.facebook },
];
---

<footer
  class="tone-night relative flex flex-col overflow-hidden pt-32 lg:min-h-[100dvh]"
  aria-label="Pie de página"
  data-footer-trigger
>
  <!-- Fila superior: navegación gigante y enlaces chicos -->
  <div class="shell">
    <div class="grid grid-cols-12 gap-x-5 gap-y-12">
      <nav class="col-span-12 lg:col-span-7" aria-label="Navegación del pie">
        <ul class="t-heading flex flex-wrap gap-x-[0.25em]">
          {
            navColumnaCompany.map((item, index) => (
              <li>
                <a href={item.href} class="transition-colors duration-200 hover:text-matrifer-cyan">
                  {item.label}
                </a>
                {index < navColumnaCompany.length - 1 && (
                  <span class="text-tone-fg" aria-hidden="true">
                    {" "}/
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="t-label col-span-12 flex flex-col gap-3 lg:col-span-3 lg:col-start-10">
        {
          redes.map((red) => (
            <li>
              <a
                href={red.href}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors duration-200 hover:text-matrifer-cyan"
              >
                {red.label}
              </a>
            </li>
          ))
        }
        {
          navColumnaLegal.map((item) => (
            <li>
              <a href={item.href} class="transition-colors duration-200 hover:text-matrifer-cyan">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Hoja de plano con tarjetas de contacto apiladas -->
  <div
    class="relative mt-16 pt-[5.3125rem] lg:absolute lg:bottom-0 lg:right-0 lg:mt-0 lg:h-[55%] lg:w-[57%] lg:pt-0"
  >
    <BlueprintGrid bare />
    <div
      class="relative z-10 overflow-hidden lg:absolute lg:bottom-0 lg:right-0 lg:w-[43.75rem] lg:max-w-[calc(100%-5.3125rem)]"
    >
      <div class="tone-paper p-8 lg:p-10 lg:pb-[15.5rem]" data-footer-layer>
        <p class="t-label text-tone-muted">Contacto</p>
        <ul class="t-sub2 mt-6 flex flex-col gap-1">
          <li>
            <a href="mailto:matrifer@hotmail.com" class="hover:underline">matrifer@hotmail.com</a>
          </li>
          <li>Colectora Sur Acceso Oeste 9924, La Reja, Moreno</li>
          <li>
            <a
              href="https://wa.me/5491154200297"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline"
            >
              +54 9 11 5420-0297
            </a>
          </li>
        </ul>
      </div>
      <div
        class="tone-accent flex min-h-[12.5rem] flex-col justify-between gap-8 p-8 lg:absolute lg:bottom-0 lg:right-0 lg:h-[12.5rem] lg:w-[30rem] lg:p-10"
        data-footer-layer
      >
        <p class="t-label-sm">Inyección a terceros</p>
        <div class="flex items-center gap-3">
          <img src="/logo.svg" alt="Logo Matrifer Moldes" class="h-8 w-auto brightness-0" loading="lazy" />
          <span class="t-sub3 text-ink">Matrifer Moldes</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bloque inferior izquierdo: servicios y copyright -->
  <div class="shell mt-16 pb-10 lg:mt-auto lg:pt-16">
    <div class="lg:max-w-[40%]">
      <ul class="t-label-sm flex flex-wrap gap-x-5 gap-y-2 text-tone-muted">
        {
          navColumnaServicios.map((item) => (
            <li>
              <a href={item.href} class="transition-colors duration-200 hover:text-matrifer-cyan">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="t-label-sm mt-6 border-t border-tone-line pt-6">
        © 2026 Matrifer Moldes. Especialistas en matricería de alta precisión y servicios de
        inyección técnica de termoplásticos a terceros.
      </p>
    </div>
  </div>
</footer>
