---
// Bloque de experiencia: declaración a la izquierda y video de planta a la derecha.
import SectionLabel from "@/components/SectionLabel.astro";

const stillImage = "/hero_image.webp";
const whatsappNumber = "5491154200297";
const defaultMessage =
  "Hola! Vi la página web de Matrifer Moldes y quería consultar por los servicios de inyección de plásticos.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<section id="about" class="tone-paper" aria-labelledby="about-titulo">
  <div class="shell grid grid-cols-12 gap-x-5 lg:min-h-[85dvh]">
    <!-- Columna de texto -->
    <div
      class="col-span-12 flex flex-col pb-12 pt-16 lg:col-span-7 lg:border-r lg:border-tone-line lg:pb-16 lg:pr-10 lg:pt-20"
    >
      <SectionLabel label="Capacidad industrial y tecnología" />
      <h2 id="about-titulo" class="t-statement mt-10 max-w-[38rem] lg:mt-12">
        Más de 30 años de trayectoria en el rubro nos definen, marcada experiencia y
        equipo/herramientas de trabajo profesional.
      </h2>

      <div class="mt-14 lg:mt-auto lg:pt-16">
        <span class="rule" data-rule></span>
        <div
          class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between lg:mt-10"
        >
          <p class="t-body-lg max-w-[21rem]">
            Personal capacitado y especializado en dichas tareas.
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link-arrow self-start"
          >
            Solicitar presupuesto<span class="sr-only"> (se abre en una pestaña nueva)</span>
            <i class="ph ph-arrow-elbow-down-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- Media: video de planta a toda la altura de la sección -->
    <div class="relative col-span-12 pb-16 lg:col-span-5 lg:col-start-8 lg:pb-0">
      <div class="relative aspect-[4/5] overflow-hidden bg-ink lg:absolute lg:inset-0 lg:aspect-auto">
        <video
          class="about-video absolute inset-0 h-full w-full object-cover object-center"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={stillImage}
          aria-hidden="true"
        >
          <source src="/hero-matrifermoldes.mp4" type="video/mp4" />
        </video>
        <img
          src={stillImage}
          alt="Inyectora de plástico Borche en un estudio oscuro"
          width="1376"
          height="768"
          class="about-still absolute inset-0 hidden h-full w-full object-cover object-center"
          loading="lazy"
          decoding="async"
        />

        <!-- Control de pausa del video -->
        <button
          type="button"
          class="about-video-toggle absolute bottom-4 right-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-[4px] bg-black text-white transition-colors duration-200 hover:bg-ink"
          aria-label="Pausar video"
        >
          <i class="ph ph-play hidden text-lg" aria-hidden="true"></i>
          <i class="ph ph-pause text-lg" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const aboutVideo = document.querySelector<HTMLVideoElement>(".about-video");
  const toggle = document.querySelector<HTMLButtonElement>(".about-video-toggle");
  const playIcon = document.querySelector(".about-video-toggle .ph-play");
  const pauseIcon = document.querySelector(".about-video-toggle .ph-pause");

  if (aboutVideo && toggle && playIcon && pauseIcon) {
    const sync = () => {
      const paused = aboutVideo.paused;
      toggle.setAttribute("aria-label", paused ? "Reproducir video" : "Pausar video");
      playIcon.classList.toggle("hidden", !paused);
      pauseIcon.classList.toggle("hidden", paused);
    };
    aboutVideo.addEventListener("play", sync);
    aboutVideo.addEventListener("pause", sync);
    toggle.addEventListener("click", () => {
      if (aboutVideo.paused) {
        void aboutVideo.play();
      } else {
        aboutVideo.pause();
      }
    });
    sync();
  }
</script>

<style>
  .about-video-toggle:focus-visible {
    outline-color: #ffffff;
  }
  @media (prefers-reduced-motion: reduce) {
    .about-video,
    .about-video-toggle {
      display: none;
    }
    .about-still {
      display: block;
    }
  }
</style>
