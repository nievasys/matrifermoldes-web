---
// Navegación fija: logo a la izquierda, caja negra con enlaces y CTA a la derecha.
// Al hacer scroll los enlaces se pliegan en un botón de menú (como la referencia).
// Escritorio: pasar el mouse (o el foco) por la caja vuelve a desplegar los enlaces.
// Móvil: el botón abre un menú a pantalla completa con los enlaces grandes.
const navItems = [
  { label: "Nosotros", href: "#about" },
  { label: "Servicios", href: "#servicios" },
  { label: "Casos de estudio", href: "#casos" },
  { label: "Ubicación", href: "#ubicacion" },
];
---

<!-- Centinela: cuando sale de pantalla (unos 80px de scroll) se pliega la navegación -->
<div
  data-nav-sentinel
  aria-hidden="true"
  class="pointer-events-none absolute left-0 top-0 h-20 w-px"
>
</div>

<header
  id="site-header"
  class="site-header pointer-events-none fixed inset-x-0 top-4 z-50 lg:top-6"
  data-tone="dark"
  data-collapsed="false"
  data-open="false"
>
  <div class="shell flex items-center justify-between">
    <!-- Marca (escritorio): el color sigue al tono de la sección de abajo -->
    <a
      href="/"
      class="brand pointer-events-auto hidden items-center gap-3 lg:flex"
      aria-label="Matrifer Moldes, inicio"
    >
      <img src="/logo.svg" alt="" class="h-8 w-auto" width="90" height="65" />
      <span class="brand-word font-display text-[1.25rem] font-medium leading-none tracking-[-0.03em]"
        >Matrifer Moldes</span
      >
    </a>

    <div data-nav-root class="pointer-events-auto relative w-full lg:w-auto">
      <div class="flex items-center gap-1 rounded-[4px] bg-black p-1">
        <!-- Marca (móvil): dentro de la barra, siempre en blanco -->
        <a
          href="/"
          class="flex items-center gap-2.5 pl-2 lg:hidden"
          aria-label="Matrifer Moldes, inicio"
        >
          <img src="/logo.svg" alt="" class="h-7 w-auto" width="90" height="65" />
          <span class="font-display text-[1.125rem] font-medium leading-none tracking-[-0.03em] text-white"
            >Matrifer Moldes</span
          >
        </a>

        <nav class="nav-links hidden overflow-hidden whitespace-nowrap lg:flex" aria-label="Navegación principal">
          {
            navItems.map((item) => (
              <a href={item.href} class="t-label p-3 text-white transition-opacity duration-200 hover:opacity-60">
                {item.label}
              </a>
            ))
          }
        </nav>

        <button
          id="menu-toggle"
          type="button"
          class="menu-btn ml-auto h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-[4px] bg-matrifer-cyan text-[1.375rem] text-ink lg:ml-0 lg:h-12 lg:w-12 lg:bg-transparent lg:text-white lg:hover:opacity-60"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="site-menu"
        >
          <i class="menu-icon-open ph ph-list" aria-hidden="true"></i>
          <i class="menu-icon-close ph ph-x hidden" aria-hidden="true"></i>
        </button>

        <a class="btn btn-primary hidden lg:inline-flex" href="#contacto">
          Contactar <i class="ph ph-arrow-elbow-down-right" aria-hidden="true"></i>
        </a>
      </div>

      <!-- Menú móvil a pantalla completa: queda detrás de la barra, que se funde con el fondo negro -->
      <div id="site-menu" class="menu-panel fixed inset-0 -z-10 bg-black px-5 pb-10 pt-[8.5rem] lg:hidden">
        <nav class="flex flex-col items-start" aria-label="Menú">
          {
            [...navItems, { label: "Contacto", href: "#contacto" }].map((item, index) => (
              <a
                href={item.href}
                class="menu-link font-display text-[2.25rem] font-normal leading-[1.4] tracking-[-0.04em] text-white transition-opacity duration-200 hover:opacity-60"
                style={`--i:${index}`}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const root = header?.querySelector<HTMLElement>("[data-nav-root]");
  const toggle = document.getElementById("menu-toggle");
  const links = header?.querySelector<HTMLElement>(".nav-links");
  const sentinel = document.querySelector("[data-nav-sentinel]");

  if (header && root && toggle) {
    const iconOpen = toggle.querySelector(".menu-icon-open");
    const iconClose = toggle.querySelector(".menu-icon-close");
    const desktop = window.matchMedia("(min-width: 1024px)");

    // Menú móvil abierto: la página de fondo no scrollea
    const lockScroll = (lock: boolean) => {
      const mobileOpen = lock && !desktop.matches;
      document.documentElement.style.overflow = mobileOpen ? "hidden" : "";
      if (mobileOpen) window.lenis?.stop();
      else window.lenis?.start();
    };

    const setOpen = (open: boolean) => {
      header.dataset.open = String(open);
      lockScroll(open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    };
    const isOpen = () => header.dataset.open === "true";

    toggle.addEventListener("click", () => {
      // Escritorio: el botón no abre nada; lleva el foco a los enlaces, que se despliegan
      if (desktop.matches) {
        links?.querySelector<HTMLElement>("a")?.focus();
        return;
      }
      setOpen(!isOpen());
    });

    document.addEventListener("nav:close", () => setOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (isOpen() && !root.contains(event.target as Node)) setOpen(false);
    });

    // Ancho real de los enlaces para que el pliegue no tenga tiempo muerto
    const measure = () => {
      if (links) links.style.setProperty("--links-w", `${links.scrollWidth}px`);
    };
    measure();
    document.fonts?.ready.then(measure);
    window.addEventListener("resize", measure);

    // Pliegue tras ~80px de scroll: observador sobre el centinela, sin escuchar scroll
    if (sentinel && "IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => {
        const collapsed = !entry.isIntersecting;
        header.dataset.collapsed = String(collapsed);
        // En escritorio, al desplegarse los enlaces el menú ya no hace falta
        if (!collapsed && desktop.matches) setOpen(false);
      }).observe(sentinel);
    }
    desktop.addEventListener("change", () => setOpen(false));

    // Tono de la sección bajo la línea del header
    const sections = document.querySelectorAll<HTMLElement>(
      "main > section, main > div > section, footer",
    );
    if (sections.length && "IntersectionObserver" in window) {
      const tones = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const list = entry.target.classList;
            const dark = list.contains("tone-dark") || list.contains("tone-night");
            header.dataset.tone = dark ? "dark" : "light";
          }
        },
        { rootMargin: "-6% 0px -93% 0px" },
      );
      sections.forEach((section) => tones.observe(section));
    }
  }
</script>

<style>
  .brand-word {
    color: #ffffff;
    transition: color 0.3s ease;
  }
  .site-header[data-tone="light"] .brand img {
    filter: brightness(0);
  }
  .site-header[data-tone="light"] .brand-word {
    color: var(--color-ink);
  }

  /* El botón de menú solo existe con JS (los enlaces quedan accesibles en el footer) */
  .menu-btn {
    display: none;
  }
  :global(.js) .menu-btn {
    display: inline-flex;
  }

  /* Menú móvil cerrado por defecto; sin JS nunca se abre */
  .menu-panel {
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .site-header[data-open="true"] .menu-panel {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.3s ease,
      visibility 0s;
  }
  .menu-link {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.4s cubic-bezier(0.215, 0.61, 0.355, 1),
      transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .site-header[data-open="true"] .menu-link {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.1s + var(--i) * 0.06s);
  }

  @media (min-width: 1024px) {
    .nav-links {
      max-width: var(--links-w, 40rem);
      transition:
        max-width 0.5s cubic-bezier(0.65, 0, 0.35, 1),
        opacity 0.3s ease 0.15s,
        transform 0.5s cubic-bezier(0.19, 1, 0.22, 1),
        visibility 0s;
    }
    .site-header[data-collapsed="true"]:not([data-open="true"]) [data-nav-root]:not(:hover, :focus-within) .nav-links {
      max-width: 0;
      opacity: 0;
      transform: translateX(1rem);
      visibility: hidden;
      transition:
        max-width 0.5s cubic-bezier(0.65, 0, 0.35, 1),
        opacity 0.2s ease,
        transform 0.5s cubic-bezier(0.19, 1, 0.22, 1),
        visibility 0s linear 0.5s;
    }
    :global(.js) .menu-btn {
      max-width: 0;
      opacity: 0;
      visibility: hidden;
      transition:
        max-width 0.5s cubic-bezier(0.65, 0, 0.35, 1),
        opacity 0.2s ease,
        visibility 0s linear 0.5s;
    }
    :global(.js) .site-header[data-collapsed="true"]:not([data-open="true"]) [data-nav-root]:not(:hover, :focus-within) .menu-btn {
      max-width: 3rem;
      opacity: 1;
      visibility: visible;
      transition:
        max-width 0.5s cubic-bezier(0.65, 0, 0.35, 1),
        opacity 0.3s ease 0.2s,
        visibility 0s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-word,
    .nav-links,
    .menu-btn,
    .menu-panel,
    :global(.js) .menu-btn,
    :global(.js) .site-header .menu-btn,
    .site-header[data-collapsed="true"] .nav-links,
    .site-header[data-open="true"] .menu-panel,
    .menu-link,
    .site-header[data-open="true"] .menu-link {
      transition: none !important;
    }
    .menu-link {
      transform: none;
    }
    .menu-panel {
      transform: none;
    }
  }
</style>
