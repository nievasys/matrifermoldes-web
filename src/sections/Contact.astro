---
const whatsappNumber = "5491154200297";
const defaultMessage =
  "Hola! Vi la página web de Matrifer Moldes y quería consultar por los servicios de inyección de plásticos.";

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<section class="relative bg-void-footer py-16" id="contacto" aria-label="Contacto">
  <div class="mx-auto w-full max-w-[1720px] px-6 lg:px-12">
    <div
      class="relative min-h-[520px] w-full overflow-hidden rounded-[34px] shadow-2xl lg:aspect-[1280/509] lg:min-h-0"
    >
      <img
        src="contact.webp"
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />

      <!-- Panel de vidrio líquido -->
      <div class="glass-panel absolute inset-x-4 inset-y-5 sm:inset-x-6 sm:inset-y-6 lg:inset-x-16 lg:inset-y-7">
        <div class="flex h-full flex-col justify-between gap-10 p-6 sm:p-10">
          <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-start lg:gap-12">
            <h2
              class="max-w-[380px] font-sans text-3xl font-normal leading-10 tracking-[-0.9px] text-black sm:text-4xl"
            >
              Estamos abiertos a proyectos nuevos
            </h2>
            <p
              class="max-w-[497px] font-sans text-base font-medium leading-[25px] text-[#27282A] sm:text-lg"
            >
              Si tenés algún proyecto de inyección de plásticos en mente, recomendamos
              que converses con nosotros para ofrecerte el mejor asesoramiento.
            </p>
          </div>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-between gap-6 rounded-[10px] bg-matrifer-blue px-6 py-7 transition-colors hover:bg-matrifer-blue-deep sm:w-fit sm:min-w-[328px] sm:py-8"
          >
            <span class="text-2xl font-light tracking-[-0.9px] text-white">Contactanos</span>
            <span class="text-3xl font-light leading-10 text-white" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>