---
import SectionLabel from "@/components/SectionLabel.astro";

const destinatario = "matrifer@hotmail.com";
---

<section id="contacto" class="tone-paper pb-28 pt-28" aria-label="Contacto">
  <div class="shell">
    <div class="grid grid-cols-12 gap-x-5 gap-y-16">
      <div class="col-span-12 lg:col-span-5">
        <SectionLabel label="Contacto" />
        <h2 class="t-heading reveal mt-8">Estamos abiertos a proyectos nuevos</h2>
        <p class="t-body-lg reveal mt-8 max-w-[28rem] text-tone-muted" style="--d:1">
          Si tenés algún proyecto de inyección de plásticos en mente, recomendamos
          que converses con nosotros para ofrecerte el mejor asesoramiento.
        </p>
      </div>

      <form id="contact-form" class="reveal col-span-12 grid gap-12 lg:col-span-6 lg:col-start-7" style="--d:2" novalidate>
        <div class="flex flex-col gap-2">
          <label for="nombre" class="t-label text-tone-fg">
            Nombre completo
          </label>
          <input
            id="nombre"
            name="nombre"
            type="text"
            required
            maxlength="60"
            placeholder="Tu nombre"
            class="w-full rounded-none border-0 border-b border-tone-line bg-transparent px-0 py-3 t-body text-tone-fg placeholder:text-tone-muted outline-none transition-[border-color,box-shadow] duration-200 focus:border-tone-fg focus:shadow-[0_1px_0_0_var(--fg)]"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="mensaje" class="t-label text-tone-fg">
            Mensaje
          </label>
          <textarea
            id="mensaje"
            name="mensaje"
            required
            rows="4"
            maxlength="2000"
            placeholder="¿En qué industria estás? ¿Cuál es tu producto o servicio? ¿Qué querés lograr con él?"
            class="min-h-[140px] resize-y w-full rounded-none border-0 border-b border-tone-line bg-transparent px-0 py-3 t-body text-tone-fg placeholder:text-tone-muted outline-none transition-[border-color,box-shadow] duration-200 focus:border-tone-fg focus:shadow-[0_1px_0_0_var(--fg)]"
          ></textarea>
        </div>

        <div>
          <button type="submit" class="btn btn-ink">
            Enviar consulta
            <i class="ph ph-arrow-elbow-down-right" aria-hidden="true"></i>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ destinatario }}>
  const form = document.querySelector("#contact-form");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const nombre = document.querySelector("#nombre")?.value.trim();
    const mensaje = document.querySelector("#mensaje")?.value.trim();
    if (!nombre || !mensaje) return;
    const body = `Hola Matrifer,\n\nSoy ${nombre} y quería consultarte sobre ${mensaje}.`;
    window.location.href = `mailto:${destinatario}?subject=${encodeURIComponent("Consulta web - Matrifer Moldes")}&body=${encodeURIComponent(body)}`;
  });
</script>