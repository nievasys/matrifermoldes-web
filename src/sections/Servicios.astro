---
import SectionBadge from '@/components/SectionBadge.astro';

// Imágenes de stock provisorias. Reemplazar la URL de cada servicio por las fotos reales.
const img = (id: string) =>
  `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=900&q=60`;

const servicios = [
  {
    title: "Inyección",
    image: img("1581093450021-4a7360e9a6b5"),
    description:
      "Procesos de inyección de termoplásticos con alta precisión, tolerancias rigurosas y acabados perfectos para piezas de demanda industrial exigente.",
  },
  {
    title: "Matricería",
    image: img("1581092335397-9583eb92d232"),
    description:
      "Además realizamos trabajos de matricería para la creación de moldes desde el diseño hasta el producto final y asesoramiento personalizado de cavidades en los moldes para un mayor rendimiento en su producción. Los moldes son construidos en acero con el alojamiento para determinada cantidad de piezas de plástico inyectado.",
  },
  {
    title: "CNC",
    image: img("1581092160562-40aa08e78837"),
    description:
      "Maquinaria de control numérico para mecanizado de alta velocidad y precisión, garantizando la dimensionalidad exacta de cada componente.",
  },
  {
    title: "Diseño CAD/CAM",
    image: img("1519389950473-47ba0277781c"),
    description:
      "Contamos con un departamento de diseño y programación para un producto nuevo o el que necesita el cliente brindándole asesoramiento por la cantidad de cavidades para lograr la mayor eficiencia.",
  },
  {
    title: "Electroerosión",
    image: img("1581092918056-0c4c3acd3789"),
    description:
      "Ofrecemos servicios de rectificado en máquina tangencial y electroerosión por penetración hasta 50 A.",
  },
];
---

<section
  class="border-t border-stroke-subtle bg-void-alt py-24"
  id="servicios"
  aria-label="Servicios de Matrifer Moldes"
>
  <div class="mx-auto w-full max-w-[1720px] px-6 lg:px-12">
    <!-- Título de sección -->
    <div class="mb-16 max-w-3xl">
      <div class="mb-4">
        <SectionBadge label="SERVICIOS Y APLICACIONES" />
      </div>
      <h2
        class="font-display text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl lg:text-[42px]"
      >
        Ofrecemos soluciones integrales donde la precisión está asegurada y el
        rendimiento, diseñado.
      </h2>
    </div>

    <!-- Grid de tarjetas de servicio -->
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {servicios.map((servicio) => (
        <div class="group cursor-pointer space-y-3">
          <div class="overflow-hidden rounded-xl border border-stroke-subtle bg-void-surface">
            <img
              src={servicio.image}
              alt={`Servicio de ${servicio.title}`}
              class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
          <h3
            class="flex items-center justify-between font-display text-xl font-semibold text-white transition-colors group-hover:text-matrifer-cyan-light"
          >
            {servicio.title}
            <span
              class="text-xs text-matrifer-cyan opacity-0 transition-opacity group-hover:opacity-100"
              aria-hidden="true"
              >↗</span
            >
          </h3>
          <p class="font-sans text-sm font-normal leading-relaxed text-content-secondary">
            {servicio.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
