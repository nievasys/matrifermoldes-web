---
// Servicios en filas que se apilan y colapsan a su título al hacer scroll (motion.ts).
const servicios = [
  {
    title: "Inyección",
    image: "/inyeccion.webp",
    description:
      "Nos dedicamos principalmente a la inyección de termoplásticos para terceros con máquinas inyectoras desde 50 TN hasta 800 TN.",
  },
  {
    title: "Matricería",
    image: "/matriceria.webp",
    description:
      "Realizamos trabajos de matricería para la creación de moldes desde el diseño hasta el producto final y asesoramiento personalizado de cavidades en los moldes para un mayor rendimiento en su producción. Los moldes son construidos en acero con el alojamiento para determinada cantidad de piezas de plástico inyectado.",
  },
  {
    title: "CNC",
    image: "/cnc.webp",
    description:
      "Maquinaria de control numérico para mecanizado de alta velocidad y precisión, garantizando la dimensionalidad exacta de cada componente.",
  },
  {
    title: "Diseño CAD/CAM",
    image: "/cad.webp",
    description:
      "Contamos con un departamento de diseño y programación para un producto nuevo o el que necesita el cliente brindándole asesoramiento por la cantidad de cavidades para lograr la mayor eficiencia.",
  },
  {
    title: "Electroerosión",
    image: "/electroerosion.webp",
    description:
      "Ofrecemos servicios de rectificado en máquina tangencial y electroerosión por penetración hasta 50 A.",
  },
];
---

<section
  id="servicios"
  class="tone-accent relative z-10 pb-16 pt-20 lg:pb-24 lg:pt-32"
  aria-label="Servicios de Matrifer Moldes"
>
  <div class="shell">
    <h2 class="t-display">Servicios y aplicaciones</h2>
    <p class="t-sub2 mt-6 max-w-[36rem] text-tone-fg lg:mt-8">
      Ofrecemos soluciones integrales donde la precisión está asegurada y el rendimiento,
      diseñado.
    </p>

    <div data-stack-track class="mt-14 lg:mt-20">
      <ul data-stack-list>
        {servicios.map((servicio) => (
          <li data-stack-card class="border-t border-tone-line last:border-b">
            <div class="grid grid-cols-12 gap-x-5 gap-y-5 py-8 lg:py-0 lg:pt-10">
              <div class="col-span-12 flex items-start gap-4 lg:col-span-4 lg:gap-10">
                <span aria-hidden="true" class="mt-[0.7em] inline-block h-2 w-2 shrink-0 bg-tone-fg"></span>
                <h3 class="t-sub2">{servicio.title}</h3>
              </div>
              <p
                data-stack-content
                class="t-body-lg col-span-12 max-w-[30rem] lg:col-span-4 lg:col-start-5"
              >
                {servicio.description}
              </p>
              <div class="col-span-12 lg:col-span-3 lg:col-start-10 lg:flex lg:justify-end">
                <img
                  src={servicio.image}
                  alt={`Servicio de ${servicio.title}`}
                  class="aspect-[3/2] w-full object-cover lg:max-w-[360px]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
