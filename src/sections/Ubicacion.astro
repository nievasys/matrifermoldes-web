---
import 'leaflet/dist/leaflet.css';

const VENUE = {
  latitude: -34.6232171,
  longitude: -58.8263015,
  zoom: 17,
};

const address =
  "Matrifer Moldes, Colectora Sur Acceso Oeste 9924, La Reja, Moreno, Buenos Aires";
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;

const cartoKey = import.meta.env.PUBLIC_CARTO_BASEMAP_KEY;
if (!cartoKey) {
  throw new Error(
    "PUBLIC_CARTO_BASEMAP_KEY no está definida. Definila en .env o en las variables de entorno del deploy.",
  );
}
---

<section
  id="ubicacion"
  class="relative border-t border-stroke-subtle bg-void-base"
  aria-label="Ubicación de Matrifer Moldes"
>
  <div class="pointer-events-none absolute inset-x-0 top-0 z-[500]">
    <div class="mx-auto w-full max-w-[1720px] px-6 pt-10 lg:px-12">
      <div
        class="reveal pointer-events-auto w-fit max-w-md rounded-xl border border-stroke-subtle bg-void-base/80 p-6 backdrop-blur-sm"
      >
        <h2
          class="font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Dónde estamos
        </h2>
        <p
          class="mt-3 font-sans text-lg font-light leading-relaxed text-content-secondary"
        >
          Colectora Sur Acceso Oeste 9924.<br />La Reja, Moreno, Buenos Aires.
        </p>
        <a
          href={googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-map-cta
          class="mt-5 inline-flex items-center gap-2 font-sans text-xs font-semibold uppercase tracking-wider text-matrifer-cyan-light transition-colors hover:text-matrifer-cyan"
        >
          Cómo llegar
          <i class="ph ph-arrow-up-right text-sm" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>

  <div class="relative h-[420px] w-full overflow-hidden lg:h-[520px]">
    <div
      id="matrifer-map"
      class="h-full w-full"
      data-latitude={VENUE.latitude}
      data-longitude={VENUE.longitude}
      data-zoom={VENUE.zoom}
      role="region"
      aria-label="Mapa con la ubicación de Matrifer Moldes en La Reja, Moreno"
    ></div>
  </div>

  <div id="matrifer-marker-template" class="hidden" aria-hidden="true">
    <i class="ph ph-map-pin text-[38px] leading-none text-matrifer-cyan"></i>
  </div>
</section>

<style>
  :global(.leaflet-container) {
    background: #050b14 !important;
    font-family: var(--font-sans) !important;
  }

  :global(.matrifer-marker) {
    background: none !important;
    border: none !important;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.7));
  }

  :global(.matrifer-marker i) {
    display: block;
    line-height: 1;
    -webkit-text-stroke: 1px rgba(2, 6, 17, 0.9);
  }

  :global(.matrifer-popup .leaflet-popup-content-wrapper) {
    background: #0b1528 !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 0.75rem !important;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6) !important;
    color: #ffffff !important;
  }

  :global(.matrifer-popup .leaflet-popup-tip) {
    background: #0b1528 !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
  }

  :global(.matrifer-popup .leaflet-popup-content) {
    margin: 0.9rem 1.1rem !important;
    font-family: var(--font-sans) !important;
  }

  :global(.matrifer-popup .leaflet-popup-content strong) {
    display: block;
    font-family: var(--font-display) !important;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
  }

  :global(.matrifer-popup .leaflet-popup-content span) {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.75rem;
    line-height: 1.6;
    color: #94a3b8;
  }

  :global(.leaflet-control-zoom) {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 0.5rem !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6) !important;
  }

  :global(.leaflet-control-zoom a) {
    background: #0b1528 !important;
    color: #94a3b8 !important;
    border: none !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  :global(.leaflet-control-zoom a:hover) {
    background: #0f1c34 !important;
    color: #ffffff !important;
  }

  :global(.leaflet-control-attribution) {
    background: rgba(2, 6, 17, 0.8) !important;
    color: rgba(148, 163, 184, 0.55) !important;
    font-size: 0.625rem !important;
  }

  :global(.leaflet-control-attribution a) {
    color: rgba(148, 163, 184, 0.75) !important;
  }
</style>

<script>
  import L from "leaflet";

  const $ = (selector: string) => document.querySelector(selector);
  const cartoKey = import.meta.env.PUBLIC_CARTO_BASEMAP_KEY ?? "";

  let mapInstance: L.Map | null = null;

function destroyMap() {
    if (mapInstance) {
      mapInstance.remove();
      mapInstance = null;
    }
  }

  function initMap() {
    try {
      destroyMap();

      const container = $("#matrifer-map") as HTMLElement | null;
      if (!container) return;

      const lat = Number(container.dataset.latitude);
      const lng = Number(container.dataset.longitude);
      const zoom = Number(container.dataset.zoom);

      if (
        !Number.isFinite(lat) ||
        !Number.isFinite(lng) ||
        !Number.isFinite(zoom)
      ) {
        return;
      }

      mapInstance = L.map(container, {
        center: [lat, lng],
        zoom,
        zoomControl: true,
        scrollWheelZoom: false,
        attributionControl: true,
      });
      mapInstance.zoomControl?.setPosition("topright");

      L.tileLayer(
        `https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?key=${cartoKey}`,
        {
          attribution:
            '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> © <a href="https://carto.com/attributions">CARTO</a>',
          subdomains: "abcd",
          maxZoom: 19,
        },
      ).addTo(mapInstance);

      const template = $("#matrifer-marker-template");
      const html = template ? template.innerHTML : "";

      const icon = L.divIcon({
        html,
        className: "matrifer-marker",
        iconSize: [38, 38],
        iconAnchor: [19, 38],
        popupAnchor: [0, -40],
      });

      const popup = L.popup({
        closeButton: false,
        maxWidth: 260,
        className: "matrifer-popup",
      }).setContent(`
        <strong>Matrifer Moldes</strong>
        <span>Colectora Sur Acceso Oeste 9924</span>
        <span>La Reja, Moreno, Buenos Aires</span>
      `);

      const marker = L.marker([lat, lng], { icon }).addTo(mapInstance);
      marker.bindPopup(popup).openPopup();

      const mapsLink = $('[data-map-cta]') as HTMLAnchorElement | null;
      const mapsUrl = mapsLink ? mapsLink.getAttribute("href") : "#";

      marker.on("click", (e: L.LeafletMouseEvent) => {
        if (e.originalEvent) e.originalEvent.stopPropagation();
        if (mapsUrl && mapsUrl !== "#") {
          window.open(mapsUrl, "_blank", "noopener,noreferrer");
        }
      });

      setTimeout(() => mapInstance?.invalidateSize(), 250);
    } catch (err) {
      console.error(err);
    }
  }

  let started = false;

  function start() {
    if (started) return;
    started = true;
    initMap();
  }

  document.addEventListener("astro:page-load", start);
  document.addEventListener("astro:before-preparation", destroyMap);
  start();
</script>