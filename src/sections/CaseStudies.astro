---
// Casos de estudio: calco de "Serving all kinds of industries" de la referencia.
// Label a la izquierda, declaración a la derecha y carrusel de tarjetas con flechas.
import SectionLabel from "@/components/SectionLabel.astro";

const casos = [
  {
    titulo: "Sillas plásticas",
    resumen: "Inyección de alto volumen y entrega de producto terminado.",
    imagen: "/casos/sillas-plasticas.webp",
    alt: "Sillas plásticas blancas apiladas en el depósito, listas para entregar",
    ancho: 506,
    alto: 900,
    ajuste: "cover",
  },
  {
    titulo: "Butapas para bebé",
    resumen: "Producción en serie de asientos inyectados en planta.",
    imagen: "/casos/asientos-produccion.webp",
    alt: "Asientos plásticos negros apilados en la planta después de la inyección",
    ancho: 645,
    alto: 900,
    ajuste: "cover",
  },
  {
    titulo: "Bañera para bebé",
    resumen: "Pieza de gran tamaño inyectada en una sola pieza.",
    imagen: "/casos/banera-bebe.webp",
    alt: "Bañera plástica blanca para bebé",
    ancho: 500,
    alto: 500,
    ajuste: "contain",
  },
  {
    titulo: "Codos de PVC",
    resumen: "Accesorio para cañerías de desagüe de diam 50 a 90°.",
    imagen: "/casos/curva-sanitaria.webp",
    alt: "Curva plástica blanca para cañería sanitaria",
    ancho: 900,
    alto: 900,
    ajuste: "contain",
  },
  {
    titulo: "Cojinetes",
    resumen: "Pieza técnica para instalaciones sanitarias.",
    imagen: "/casos/cojinete.webp",
    alt: "Cojinete plástico negro con bocas de conexión para caños",
    ancho: 900,
    alto: 900,
    ajuste: "contain",
  },
  {
    titulo: "Sillas para escuela",
    resumen: "Asientos y respaldos inyectados para uso en instituciones  educativas.",
    imagen: "/casos/asientos-sillas.webp",
    alt: "Sillas apiladas con asientos plásticos naranja y azul sobre estructura metálica",
    ancho: 554,
    alto: 554,
    ajuste: "cover",
  },
];
---

<section id="casos" class="tone-light overflow-clip pb-24 pt-16 lg:pb-28 lg:pt-24" aria-labelledby="casos-titulo">
  <div class="shell">
    <span class="rule" data-rule></span>

    <!-- Encabezado: label a la izquierda, declaración grande a la derecha -->
    <div class="mt-8 grid grid-cols-12 gap-x-5 gap-y-8">
      <div id="casos-titulo" class="col-span-12 lg:col-span-4">
        <SectionLabel label="Casos de estudio" as="h2" />
      </div>
      <p class="t-sub1 reveal col-span-12 max-w-[48rem] lg:col-span-8 lg:col-start-5 lg:pl-10">
        Proyectos de inyección resueltos en planta, del molde a la pieza terminada.
      </p>
    </div>

    <!-- Carrusel horizontal: sangra hasta el borde derecho del viewport -->
    <div
      class="no-scrollbar -mr-5 mt-20 flex snap-x snap-mandatory gap-5 overflow-x-auto pr-5 lg:-mr-10 lg:mt-32 lg:pr-10"
      id="casos-track"
      data-cases-track
      data-lenis-prevent-horizontal
      tabindex="0"
      aria-label="Listado de casos de estudio"
      role="region"
    >
      {
        // Tres tandas iguales: la del medio es la real; las de los costados son copias
        // que permiten saltar sin que se note y dar la vuelta infinita.
        [0, 1, 2].flatMap((tanda) =>
          casos.map((caso, index) => ({ caso, index, copia: tanda !== 1 })),
        ).map(({ caso, index, copia }) => (
          <article
            class="reveal w-[78vw] shrink-0 snap-start sm:w-[20.3125rem]"
            style={`--d:${index}`}
            data-cases-card
            data-cases-clone={copia ? "" : undefined}
            aria-hidden={copia ? "true" : undefined}
            inert={copia ? true : undefined}
          >
            <img
              src={caso.imagen}
              alt={caso.alt}
              width={caso.ancho}
              height={caso.alto}
              class={`aspect-square w-full ${caso.ajuste === "contain" ? "bg-white object-contain p-6" : "object-cover"}`}
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            <h3 class="t-sub3 mt-6 text-tone-fg">{caso.titulo}</h3>
            <p class="t-body mt-3 max-w-[18rem] text-tone-muted">{caso.resumen}</p>
          </article>
        ))
      }
    </div>

    <!-- Controles del carrusel -->
    <div class="mt-10 flex items-center gap-10">
      <span class="rule flex-1" data-rule></span>
      <div class="cases-controls gap-2">
        <button type="button" class="cases-btn" data-cases-prev aria-label="Caso anterior" aria-controls="casos-track">
          <i class="ph ph-arrow-left text-xl" aria-hidden="true"></i>
        </button>
        <button type="button" class="cases-btn" data-cases-next aria-label="Caso siguiente" aria-controls="casos-track">
          <i class="ph ph-arrow-right text-xl" aria-hidden="true"></i>
        </button>
      </div>
    </div>
    <p class="sr-only" aria-live="polite" data-cases-status></p>
  </div>
</section>

<style>
  .cases-controls {
    display: none;
  }
  :global(.js) .cases-controls {
    display: flex;
  }
  .cases-btn {
    display: inline-flex;
    height: 3.5rem;
    width: 3.5rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-ref);
    background-color: var(--soft);
    color: var(--fg);
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      opacity 0.25s ease;
  }
  .cases-btn:hover:not(:disabled) {
    background-color: var(--line);
  }
  @media (pointer: fine) {
    [data-cases-track] {
      cursor: grab;
    }
    [data-cases-track][data-dragging] {
      cursor: grabbing;
      user-select: none;
    }
  }
    /* Sin JS no hay vuelta infinita: se muestran solo los casos reales */
  :global(html:not(.js)) [data-cases-clone] {
    display: none;
  }
  .cases-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>

<script>
  // Carrusel infinito: las tarjetas están en tres tandas iguales. Se navega sobre la
  // del medio y, al terminar cada desplazamiento, si quedó en una copia se salta sin
  // animación a la misma posición de la tanda real.
  const track = document.querySelector<HTMLElement>("[data-cases-track]");
  const prev = document.querySelector<HTMLButtonElement>("[data-cases-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-cases-next]");
  const status = document.querySelector<HTMLElement>("[data-cases-status]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (track && prev && next) {
    const total = track.querySelectorAll("[data-cases-card]:not([data-cases-clone])").length;
    let actual = 0;
    const paso = () => {
      const card = track.querySelector<HTMLElement>("[data-cases-card]");
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const tanda = () => paso() * total;

    const saltar = (left: number) => {
      track.style.scrollBehavior = "auto";
      track.style.scrollSnapType = "none";
      track.scrollLeft = left;
      track.style.scrollSnapType = "";
      track.style.scrollBehavior = "";
    };

    const normalizar = () => {
      const ancho = tanda();
      if (track.scrollLeft < ancho * 0.5) saltar(track.scrollLeft + ancho);
      else if (track.scrollLeft >= ancho * 1.5) saltar(track.scrollLeft - ancho);
      anunciar();
    };

    const anunciar = () => {
      const caso = (((Math.round(track.scrollLeft / paso()) % total) + total) % total) + 1;
      if (status && caso !== actual) {
        actual = caso;
        status.textContent = `Caso ${caso} de ${total}`;
      }
    };

    const mover = (direccion: number) => {
      track.scrollBy({ left: direccion * paso(), behavior: reduce.matches ? "auto" : "smooth" });
      if (reduce.matches) normalizar();
    };

    // Fin de desplazamiento: una pausa corta sin eventos de scroll. scrollend no es
    // confiable en contenedores con scroll-snap en todos los navegadores.
    let espera: number | undefined;
    track.addEventListener(
      "scroll",
      () => {
        anunciar();
        window.clearTimeout(espera);
        espera = window.setTimeout(normalizar, 140);
      },
      { passive: true },
    );

    // Arrastre con el mouse (en touch el gesto ya es nativo). Durante el arrastre se
    // apaga el snap y al soltar se acomoda a la tarjeta más cercana.
    let arrastre: { x: number; left: number; id: number } | null = null;
    track.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      arrastre = { x: event.clientX, left: track.scrollLeft, id: event.pointerId };
      track.setPointerCapture(event.pointerId);
      track.style.scrollSnapType = "none";
      track.style.scrollBehavior = "auto";
      track.dataset.dragging = "";
    });
    track.addEventListener("pointermove", (event) => {
      if (!arrastre || event.pointerId !== arrastre.id) return;
      track.scrollLeft = arrastre.left - (event.clientX - arrastre.x);
    });
    const soltar = (event: PointerEvent) => {
      if (!arrastre || event.pointerId !== arrastre.id) return;
      arrastre = null;
      track.releasePointerCapture(event.pointerId);
      delete track.dataset.dragging;
      const destino = Math.round(track.scrollLeft / paso()) * paso();
      track.style.scrollBehavior = "";
      track.scrollTo({ left: destino, behavior: reduce.matches ? "auto" : "smooth" });
      window.setTimeout(() => (track.style.scrollSnapType = ""), reduce.matches ? 0 : 450);
    };
    track.addEventListener("pointerup", soltar);
    track.addEventListener("pointercancel", soltar);

    prev.addEventListener("click", () => mover(-1));
    next.addEventListener("click", () => mover(1));
    window.addEventListener("resize", () => saltar(tanda() + (track.scrollLeft % tanda())));

    saltar(tanda());
    anunciar();
  }
</script>
