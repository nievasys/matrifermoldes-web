---
// Casos de estudio: declaración, tres columnas con foto y ficha técnica, cierre con CTA.
import SectionLabel from "@/components/SectionLabel.astro";

const whatsappNumber = "5491154200297";
const defaultMessage =
  "Hola! Vi la página web de Matrifer Moldes y quería consultar por los servicios de inyección de plásticos.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(defaultMessage)}`;

const casos = [
  {
    nombre: "Sillas Plásticas",
    activo: true,
    titulo: "Sillas Plásticas Inyectadas",
    resumen:
      "Recepción de matriz externa. Ajuste en planta, inyección de alto volumen y entrega de producto terminado listo para ensamble.",
    imagen: "/noticiasillas.webp",
    especificaciones: [
      { label: "Máquina", valor: "Inyectora 800 TN" },
      { label: "Material", valor: "Polipropileno (PP)" },
      { label: "Cavidades", valor: "1" },
    ],
  },
  {
    nombre: "Carcasas ABS",
    activo: false,
    titulo: "Carcasas ABS",
    resumen:
      "Proyecto en desarrollo. Inyección de carcasas en ABS con materiales técnicos y control dimensional.",
    imagen: "/inyeccion.webp",
    especificaciones: [
      { label: "Máquina", valor: "Por definir" },
      { label: "Material", valor: "ABS" },
      { label: "Cavidades", valor: "Por definir" },
    ],
  },
  {
    nombre: "Engranajes Nylon",
    activo: false,
    titulo: "Engranajes Nylon",
    resumen:
      "Proyecto en desarrollo. Engranajes técnicos en poliamida para aplicaciones de alta exigencia.",
    imagen: "/inyeccion.webp",
    especificaciones: [
      { label: "Máquina", valor: "Por definir" },
      { label: "Material", valor: "Poliamida (PA)" },
      { label: "Cavidades", valor: "Por definir" },
    ],
  },
];
---

<section id="casos" class="tone-dark relative overflow-hidden pb-12 pt-20 lg:pt-28" aria-label="Casos de estudio">
  <!-- Líneas decorativas que bajan desde el borde superior, como los cables de la referencia -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 hidden h-56 lg:block">
    <span class="absolute left-[67%] top-0 h-full w-px bg-matrifer-cyan/50"></span>
    <span class="absolute left-[calc(67%+24px)] top-0 h-full w-px bg-white/20"></span>
  </div>

  <div class="shell relative">
    <SectionLabel label="Casos de estudio" />
    <h2 class="t-statement mt-8 max-w-[34rem]">
      Tres proyectos de inyección resueltos en planta, del molde a la pieza terminada.
    </h2>

    <ul class="mt-12 grid grid-cols-1 gap-x-5 gap-y-14 md:grid-cols-3 lg:mt-16">
      {casos.map((caso, index) => (
        <li class="reveal flex flex-col" style={`--d:${index}`}>
          <img
            src={caso.imagen}
            alt={`Caso de estudio: ${caso.titulo}`}
            class="aspect-[16/15] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <h3 class="t-sub3 mt-5">{caso.titulo}</h3>
          <p class="t-body mt-3 max-w-[26rem] text-tone-muted">{caso.resumen}</p>
          <dl class="t-label-sm mt-6 border-t border-tone-line">
            {caso.especificaciones.map((spec) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-tone-line py-2.5">
                <dt class="text-tone-muted">{spec.label}</dt>
                <dd class="text-right tabular-nums text-tone-fg">{spec.valor}</dd>
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ul>

    <div class="mt-24 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between lg:mt-36">
      <h2 class="t-heading">Ingeniería aplicada</h2>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="link-arrow self-start sm:self-auto sm:pb-2"
      >
        Solicitar presupuesto
        <i class="ph ph-arrow-elbow-down-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>
