---
// Casos de estudio: calco de "Serving all kinds of industries" de la referencia.
// Label a la izquierda, declaración a la derecha y carrusel de tarjetas con flechas.
import SectionLabel from "@/components/SectionLabel.astro";

const casos = [
  {
    titulo: "Sillas Plásticas Inyectadas",
    resumen:
      "Recepción de matriz externa. Ajuste en planta, inyección de alto volumen y entrega de producto terminado listo para ensamble.",
    imagen: "/noticiasillas.webp",
    alt: "Sillas plásticas blancas apiladas en el depósito, listas para entregar",
    ancho: 2250,
    alto: 4000,
  },
  {
    titulo: "Carcasas ABS",
    resumen:
      "Proyecto en desarrollo. Inyección de carcasas en ABS con materiales técnicos y control dimensional.",
    imagen: "/inyeccion.webp",
    alt: "Inyectora de plástico modelo BS800-III en la planta",
    ancho: 1838,
    alto: 1870,
  },
  {
    titulo: "Engranajes Nylon",
    resumen:
      "Proyecto en desarrollo. Engranajes técnicos en poliamida para aplicaciones de alta exigencia.",
    imagen: "/inyeccion.webp",
    alt: "Inyectora de plástico modelo BS800-III en la planta",
    ancho: 1838,
    alto: 1870,
  },
];
---

<section id="casos" class="tone-light overflow-clip pb-24 pt-16 lg:pb-28 lg:pt-24" aria-labelledby="casos-titulo">
  <div class="shell">
    <span class="rule" data-rule></span>

    <!-- Encabezado: label a la izquierda, declaración grande a la derecha -->
    <div class="mt-8 grid grid-cols-12 gap-x-5 gap-y-8">
      <div id="casos-titulo" class="col-span-12 lg:col-span-4">
        <SectionLabel label="Casos de estudio" as="h2" />
      </div>
      <p class="t-sub1 reveal col-span-12 max-w-[48rem] lg:col-span-8 lg:col-start-5 lg:pl-10">
        Tres proyectos de inyección resueltos en planta, del molde a la pieza terminada.
      </p>
    </div>

    <!-- Carrusel horizontal: sangra hasta el borde derecho del viewport -->
    <div
      class="no-scrollbar -mr-5 mt-20 flex snap-x snap-mandatory gap-5 overflow-x-auto pr-5 lg:-mr-10 lg:mt-32 lg:pr-10"
      id="casos-track"
      data-cases-track
      data-lenis-prevent-horizontal
      tabindex="0"
      aria-label="Listado de casos de estudio"
      role="region"
    >
      {
        casos.map((caso, index) => (
          <article
            class="reveal w-[78vw] shrink-0 snap-start sm:w-[20.3125rem]"
            style={`--d:${index}`}
            data-cases-card
          >
            <img
              src={caso.imagen}
              alt={caso.alt}
              width={caso.ancho}
              height={caso.alto}
              class="aspect-square w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <h3 class="t-sub3 mt-6 text-tone-fg">{caso.titulo}</h3>
            <p class="t-body mt-3 max-w-[18rem] text-tone-muted">{caso.resumen}</p>
          </article>
        ))
      }
    </div>

    <!-- Controles del carrusel -->
    <div class="mt-10 flex items-center gap-10">
      <span class="rule flex-1" data-rule></span>
      <div class="cases-controls gap-2">
        <button type="button" class="cases-btn" data-cases-prev aria-label="Caso anterior" aria-controls="casos-track">
          <i class="ph ph-arrow-left text-xl" aria-hidden="true"></i>
        </button>
        <button type="button" class="cases-btn" data-cases-next aria-label="Caso siguiente" aria-controls="casos-track">
          <i class="ph ph-arrow-right text-xl" aria-hidden="true"></i>
        </button>
      </div>
    </div>
    <p class="sr-only" aria-live="polite" data-cases-status></p>
  </div>
</section>

<style>
  .cases-controls {
    display: none;
  }
  :global(.js) .cases-controls {
    display: flex;
  }
  .cases-btn {
    display: inline-flex;
    height: 3.5rem;
    width: 3.5rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-ref);
    background-color: var(--soft);
    color: var(--fg);
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      opacity 0.25s ease;
  }
  .cases-btn:hover:not(:disabled) {
    background-color: var(--line);
  }
  .cases-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>

<script>
  // Avanza o retrocede el carrusel de a una tarjeta y deshabilita los extremos.
  const track = document.querySelector<HTMLElement>("[data-cases-track]");
  const prev = document.querySelector<HTMLButtonElement>("[data-cases-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-cases-next]");
  const status = document.querySelector<HTMLElement>("[data-cases-status]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (track && prev && next) {
    const total = track.querySelectorAll("[data-cases-card]").length;
    let actual = 1;
    const paso = () => {
      const card = track.querySelector<HTMLElement>("[data-cases-card]");
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };

    const actualizar = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
      const caso = next.disabled
        ? total
        : Math.min(total, Math.round(track.scrollLeft / paso()) + 1);
      if (status && caso !== actual) {
        actual = caso;
        status.textContent = `Caso ${caso} de ${total}`;
      }
    };

    const mover = (direccion: number) => {
      track.scrollBy({
        left: direccion * paso(),
        behavior: reduce.matches ? "auto" : "smooth",
      });
    };

    prev.addEventListener("click", () => mover(-1));
    next.addEventListener("click", () => mover(1));
    track.addEventListener("scroll", actualizar, { passive: true });
    window.addEventListener("resize", actualizar);
    actualizar();
  }
</script>
