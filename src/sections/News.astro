---
// Imágenes de stock provisorias. Reemplazar la URL de cada noticia por las fotos reales.
const img = (id: string) =>
  `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=900&q=60`;

const noticias = [
  {
    categoria: "NOTICIAS · 3 MIN LECTURA",
    image: "noticiasillas.webp",
    titulo:
      "Estamos muy contentos de estar trabajando en este nuevo proyecto: Molde de diseño innovador de sillas plásticas.",
  },
  {
    categoria: "INFORMES · 2 MIN LECTURA",
    image: "noticiamudanza.webp",
    titulo: "Nos mudamos! Abrimos una nueva planta de procesos de inyección y matriceria en Moreno.",
  },
  {
    categoria: "INFORMES · 2 MIN LECTURA",
    image: "noticiaborche.webp",
    titulo: "Nuestra moderna e innovadora máquina de inyección BS800-III con motores servo de última generación.  ",
  },
];
---

<section
  class="border-t border-stroke-subtle bg-void-base py-24"
  id="noticias"
  aria-label="Noticias y novedades"
>
  <div class="mx-auto w-full max-w-[1720px] px-6 lg:px-12">
    <!-- Encabezado -->
    <div class="mb-12 flex items-center justify-between">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">
        Noticias &amp; Novedades
      </h2>
      <a
        href="#noticias"
        class="flex items-center gap-1 font-sans text-xs font-medium uppercase tracking-wider text-content-secondary transition-colors hover:text-matrifer-cyan-light"
      >
        <span>Ver todo</span>
        <i class="ph ph-arrow-right text-xs" aria-hidden="true"></i>
      </a>
    </div>

    <!-- Tarjetas de contenido -->
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {noticias.map((noticia, index) => (
        <article class="group reveal cursor-pointer space-y-3" style={`--d:${index}`}>
          <div class="overflow-hidden rounded-xl border border-stroke-subtle bg-void-surface">
            <img
              src={noticia.image}
              alt=""
              class="aspect-[16/9] w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div
            class="font-display text-[11px] font-semibold uppercase tracking-widest text-content-secondary"
          >
            {noticia.categoria}
          </div>
          <h3
            class="font-sans text-lg font-normal leading-snug text-white transition-colors group-hover:text-matrifer-cyan-light"
          >
            {noticia.titulo}
          </h3>
        </article>
      ))}
    </div>
  </div>
</section>
