---
// Imágenes de stock provisorias. Reemplazar la URL de cada noticia por las fotos reales.
const img = (id: string) =>
  `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=900&q=60`;

const noticias = [
  {
    categoria: "NOTICIAS — 3 MIN LECTURA",
    image: img("1581093588401-fbb62a02f120"),
    titulo:
      "Matrifer Moldes incorpora nueva tecnología de inyección para mejorar la precisión de sus piezas.",
  },
  {
    categoria: "INFORMES — 2 MIN LECTURA",
    image: img("1504384308090-c894fdcc538d"),
    titulo: "Datos en tiempo real: de la información a la acción en tu producción.",
  },
  {
    categoria: "INFORMES — 2 MIN LECTURA",
    image: img("1550751827-4bd374c3f58b"),
    titulo: "El rol del diseño CAD/CAM en la ingeniería moderna de moldes.",
  },
];
---

<section
  class="border-t border-stroke-subtle bg-void-base py-24"
  id="noticias"
  aria-label="Noticias y novedades"
>
  <div class="mx-auto w-full max-w-[1720px] px-6 lg:px-12">
    <!-- Encabezado -->
    <div class="mb-12 flex items-center justify-between">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">
        Noticias &amp; Novedades
      </h2>
      <a
        href="#noticias"
        class="flex items-center gap-1 font-sans text-xs font-medium uppercase tracking-wider text-content-secondary transition-colors hover:text-matrifer-cyan-light"
      >
        <span>Ver todo</span>
        <svg
          class="h-3.5 w-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M9 5l7 7-7 7"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          ></path>
        </svg>
      </a>
    </div>

    <!-- Tarjetas de contenido -->
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {noticias.map((noticia) => (
        <article class="group cursor-pointer space-y-3">
          <div class="overflow-hidden rounded-xl border border-stroke-subtle bg-void-surface">
            <img
              src={noticia.image}
              alt=""
              class="aspect-[16/9] w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div
            class="font-display text-[11px] font-semibold uppercase tracking-widest text-matrifer-cyan"
          >
            {noticia.categoria}
          </div>
          <h3
            class="font-display text-lg font-medium leading-snug text-white transition-colors group-hover:text-matrifer-blue"
          >
            {noticia.titulo}
          </h3>
        </article>
      ))}
    </div>
  </div>
</section>
