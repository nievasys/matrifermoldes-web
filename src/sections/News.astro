---
import SectionLabel from "@/components/SectionLabel.astro";

// Noticias del carrusel. Las imágenes viven en /public.
const noticias = [
  {
    categoria: "NOTICIAS · 3 MIN LECTURA",
    image: "/noticiasillas.webp",
    titulo:
      "Estamos muy contentos de estar trabajando en este nuevo proyecto: Molde de diseño innovador de sillas plásticas.",
  },
  {
    categoria: "INFORMES · 2 MIN LECTURA",
    image: "/noticiamudanza.webp",
    titulo: "Nos mudamos! Abrimos una nueva planta de procesos de inyección y matriceria en Moreno.",
  },
  {
    categoria: "INFORMES · 2 MIN LECTURA",
    image: "/noticiaborche.webp",
    titulo: "Nuestra moderna e innovadora máquina de inyección BS800-III con motores servo de última generación.",
  },
];
---

<section
  id="noticias"
  class="tone-light overflow-clip pb-24 pt-24"
  aria-label="Noticias y novedades"
>
  <div class="shell">
    <span class="rule" data-rule></span>

    <div class="mt-8 grid grid-cols-12 gap-x-5">
      <div class="col-span-12 lg:col-span-4">
        <SectionLabel label="Noticias & Novedades" as="h2" />
      </div>
    </div>

    <!-- Carrusel horizontal: sangra hasta el borde derecho del viewport -->
    <div
      class="no-scrollbar -mr-5 mt-16 flex snap-x snap-mandatory gap-5 overflow-x-auto pr-5 lg:-mr-10 lg:pr-10"
      data-news-track
      tabindex="0"
      aria-label="Listado de noticias"
      role="region"
    >
      {
        noticias.map((noticia, index) => (
          <article
            class="group reveal w-[78vw] shrink-0 snap-start sm:w-[21.5625rem] lg:w-[34vw]"
            style={`--d:${index}`}
            data-news-card
          >
            <div class="aspect-square w-full overflow-hidden bg-tone-soft lg:aspect-[4/3]">
              <img
                src={noticia.image}
                alt=""
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <p class="t-label-sm mt-5 text-tone-muted">{noticia.categoria}</p>
            <h3 class="t-sub3 mt-2 max-w-[22rem] font-medium text-tone-fg">{noticia.titulo}</h3>
          </article>
        ))
      }
    </div>

    <!-- Controles del carrusel -->
    <div class="mt-10 flex items-center gap-5">
      <span class="rule flex-1" data-rule></span>
      <div class="flex gap-4">
        <button
          type="button"
          class="news-btn"
          data-news-prev
          aria-label="Noticia anterior"
        >
          <i class="ph ph-arrow-left text-xl" aria-hidden="true"></i>
        </button>
        <button
          type="button"
          class="news-btn"
          data-news-next
          aria-label="Noticia siguiente"
        >
          <i class="ph ph-arrow-right text-xl" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .news-btn {
    display: inline-flex;
    height: 3rem;
    width: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-ref);
    background-color: var(--soft);
    color: var(--fg);
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      opacity 0.25s ease;
  }
  .news-btn:hover:not(:disabled) {
    background-color: var(--line);
  }
  .news-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>

<script>
  // Avanza o retrocede el carrusel de a una tarjeta y deshabilita los extremos.
  const track = document.querySelector<HTMLElement>("[data-news-track]");
  const prev = document.querySelector<HTMLButtonElement>("[data-news-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-news-next]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (track && prev && next) {
    const paso = () => {
      const card = track.querySelector<HTMLElement>("[data-news-card]");
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };

    const actualizar = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    const mover = (direccion: number) => {
      track.scrollBy({
        left: direccion * paso(),
        behavior: reduce.matches ? "auto" : "smooth",
      });
    };

    prev.addEventListener("click", () => mover(-1));
    next.addEventListener("click", () => mover(1));
    track.addEventListener("scroll", actualizar, { passive: true });
    window.addEventListener("resize", actualizar);
    actualizar();
  }
</script>
